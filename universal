    local function GetChar(plr)
        local ch = plr.Character
        if not ch or not ch.Parent then return nil, nil, nil end
        local hum = ch:FindFirstChildOfClass("Humanoid")
        if not hum then return ch, nil, nil end
        local hrp = hum.RootPart or ch:FindFirstChild("HumanoidRootPart") or ch.PrimaryPart
        return ch, hum, hrp
    end

    local function FindPart(ch, names)
        for _, n in ipairs(names) do
            local p = ch:FindFirstChild(n)
            if p and p:IsA("BasePart") then return p end
        end
        return nil
    end

    local function GetAim(char, boneOverride)
        if boneOverride == "Random" then
            local opts = { "Head", "UpperTorso", "Torso", "HumanoidRootPart" }
            return FindPart(char, { opts[math.random(#opts)] }) or FindPart(char, { "Head", "HumanoidRootPart" })
        end
        return FindPart(char, { boneOverride or CFG.AimBone or "Head", "Head", "UpperTorso", "Torso", "HumanoidRootPart" })
    end

    local function IsVisibleFromCamera(targetPart)
        if not CFG.WallCheck then return true end
        local origin = Camera.CFrame.Position
        local dir    = targetPart.Position - origin
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = { LP.Character, Camera }
        local hit = workspace:Raycast(origin, dir, params)
        return hit == nil or hit.Instance:IsDescendantOf(targetPart.Parent)
    end

    local function notify(msg, kind)

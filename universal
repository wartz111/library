            hl.FillTransparency = 0.5; hl.Enabled = false
            hl.FillColor = CFG.ESPColor or Library.Accent
            hl.OutlineColor = CFG.ESPColor or Library.Accent
            pcall(function() hl.Parent = game:GetService("CoreGui") end)

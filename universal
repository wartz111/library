    --================================================--
    -- FLY
    --================================================--
    local function StartFly()
        local ch, h, hrp = GetChar(LP)
        if not hrp or not h then return end
        flying = true
        oAR = h.AutoRotate
        h.AutoRotate = false
        h.PlatformStand = true
        if not CFG.Noclip then
            table.clear(flySC)
            for _, p in ipairs(ch:GetDescendants()) do
                if p:IsA("BasePart") then flySC[p] = p.CanCollide; p.CanCollide = false end
            end
        end
    end

    local function StopFly()
        local ch, h, hrp = GetChar(LP)
        flying = false
        if h then h.PlatformStand = false; h.AutoRotate = oAR end
        if hrp then hrp.AssemblyLinearVelocity = Vector3.zero end
        if not CFG.Noclip then
            for p, v in pairs(flySC) do
                if p and p.Parent then pcall(function() p.CanCollide = v end) end
            end
        end
        table.clear(flySC)
    end

    --================================================--
    -- INPUT
    --================================================--
    UIS.InputBegan:Connect(function(i, g)
        if g then return end
        local k = i.KeyCode
        if     k == Enum.KeyCode.W then move.F = 1
        elseif k == Enum.KeyCode.S then move.B = 1
        elseif k == Enum.KeyCode.A then move.L = 1
        elseif k == Enum.KeyCode.D then move.R = 1
        elseif k == Enum.KeyCode.Space then move.U = 1
        elseif k == Enum.KeyCode.LeftControl then move.D = 1
        end
        if CFG.AimKey and (k == Enum.KeyCode.LeftAlt or k == Enum.KeyCode.RightAlt) then
            aimHeld = true
        end
    end)
    UIS.InputEnded:Connect(function(i)
        local k = i.KeyCode
        if     k == Enum.KeyCode.W then move.F = 0
        elseif k == Enum.KeyCode.S then move.B = 0
        elseif k == Enum.KeyCode.A then move.L = 0
        elseif k == Enum.KeyCode.D then move.R = 0
        elseif k == Enum.KeyCode.Space then move.U = 0
        elseif k == Enum.KeyCode.LeftControl then move.D = 0
        end
        if k == Enum.KeyCode.LeftAlt or k == Enum.KeyCode.RightAlt then
            aimHeld = false
        end
    end)


    --================================================--
    LP.Idled:Connect(function()
        if CFG.AntiAFK then
            pcall(function()
                VirtualUser:CaptureController()
                VirtualUser:ClickButton2(Vector2.new())
            end)
        end
    end)

    --================================================--
    -- Instant Prompt
    --================================================--
    ProximityPromptService.PromptShown:Connect(function(p)
        if CFG.InstantPrompt then p.HoldDuration = 0 end
    end)

    --================================================--
    -- Third Person real (BindToRenderStep)
    --================================================--
    RunService:BindToRenderStep("HubTPCam", Enum.RenderPriority.Camera.Value + 1, function()
        if not CFG.ThirdPerson then return end
        local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if not hrp then return end
        local dist = CFG.TP_Distance or 14
        local hgt  = CFG.TP_Height or 2
        local look = Camera.CFrame.LookVector
        local pos  = hrp.Position - look * dist + Vector3.new(0, hgt, 0)
        Camera.CFrame = CFrame.new(pos, hrp.Position + look * 10) * CFrame.Angles(math.rad(-8), 0, 0)
    end)

    Window:WaitLoaded()
    task.wait(1.5)
    notify("Features universais v12.0 carregadas!", "success")
end

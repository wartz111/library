            d.highlight = hl

            local function bindChar(ch)
                if d.highlight then d.highlight.Adornee = ch end
            end
            if plr.Character then bindChar(plr.Character) end
            plr.CharacterAdded:Connect(bindChar)

            ESP_DATA[plr] = d
        end)

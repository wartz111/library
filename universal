            d.box.Color = CFG.ESPColor or Library.Accent
            d.text.Size = 13; d.text.Center = true; d.text.Outline = true
            d.text.Color = Color3.new(1, 1, 1); d.text.Visible = false
            d.weaponText.Size = 12; d.weaponText.Center = true; d.weaponText.Outline = true

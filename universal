    --================================================--
    -- HEARTBEAT — Fly, Noclip, AntiFling, AntiStun, Spin, Invisivel, Hitbox, KillAura
    --================================================--
    RunService.Heartbeat:Connect(function()
        local ch, h, hrp = GetChar(LP)
        if flying and (not ch or not h or not hrp or h.Health <= 0) then StopFly() end

        -- Fly
        if CFG.Fly and hrp and h then
            if not flying then StartFly() end
            local v = (Camera.CFrame.LookVector * (move.F - move.B))
                    + (Camera.CFrame.RightVector * (move.R - move.L))
                    + (Vector3.new(0,1,0)       * (move.U - move.D))
            local ms = math.clamp(CFG.FlySpeed or 18, 5, 50)
            if v.Magnitude > 0 then hrp.AssemblyLinearVelocity = v.Unit * ms
            else hrp.AssemblyLinearVelocity = Vector3.zero end
            for _, p in pairs(ch:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide = false end
            end
        elseif flying then
            StopFly()
        end

        -- Noclip
        if ch then
            if CFG.Noclip and not flying then
                for _, v in ipairs(ch:GetDescendants()) do
                    if v:IsA("BasePart") then
                        if ncS[v] == nil then ncS[v] = v.CanCollide end
                        v.CanCollide = false
                    end
                end
            elseif next(ncS) ~= nil then
                for p, v in pairs(ncS) do
                    if p and p.Parent then pcall(function() p.CanCollide = v end) end
                end
                table.clear(ncS)
            end
        end

        -- Anti-Fling / Anti-Fling V2 / Anti-Stun
        if hrp and (CFG.AntiFling or CFG.AntiFlingV2 or CFG.AntiStun) then
            for _, v in ipairs(hrp:GetChildren()) do
                if v:IsA("BodyVelocity") or v:IsA("BodyAngularVelocity")
                   or v:IsA("BodyThrust") or v:IsA("BodyForce") then
                    v:Destroy()
                end
            end
            if CFG.AntiFlingV2 then hrp.AssemblyAngularVelocity = Vector3.zero end
        end
        if h and CFG.AntiStun and h.Health > 0 then
            pcall(function()
                h:ChangeState(Enum.HumanoidStateType.GettingUp)
                if h.WalkSpeed < 3 then h.WalkSpeed = CFG.WalkSpeed or 16 end
            end)
        end

        -- Spin / WalkSpeed / JumpPower / Invisivel
        if h and ch then
            if CFG.Spin and hrp then
                hrp.CFrame = hrp.CFrame * CFrame.Angles(0, math.rad((CFG.SpinSpeed or 150)/10), 0)
            end
            if CFG.Invisible then
                for _, v in ipairs(ch:GetDescendants()) do
                    if v:IsA("BasePart") or v:IsA("Decal") then
                        if transpCache[v] == nil then transpCache[v] = v.Transparency end
                        v.Transparency = 1
                    end
                end
            elseif next(transpCache) ~= nil then
                for p, t in pairs(transpCache) do
                    if p and p.Parent then pcall(function() p.Transparency = t end) end
                end
                table.clear(transpCache)
            end

            local ws = math.clamp(CFG.WalkSpeed or 16, 16, 200)
            if math.abs(h.WalkSpeed - ws) > 0.5 then pcall(function() h.WalkSpeed = ws end) end
            local jp = math.clamp(CFG.JumpPower or 50, 50, 300)
            if math.abs(h.JumpPower - jp) > 0.5 then pcall(function() h.JumpPower = jp end) end
        end

        -- Hitbox Expander
        if CFG.HitboxEnabled then
            local size = CFG.HitboxSize or 2
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LP then continue end
                local tc, th = GetChar(p)
                if tc and th and th.Health > 0 then
                    local head = tc:FindFirstChild("Head")
                    if head and not hbCache[head] then
                        hbCache[head] = { size = head.Size, transp = head.Transparency,
                                          collide = head.CanCollide, massless = head.Massless }
                        head.Size = Vector3.new(size, size, size)
                        head.Transparency = 1
                        head.CanCollide = false
                        head.Massless = true
                    elseif head and hbCache[head] then
                        head.Size = Vector3.new(size, size, size)
                    end
                end
            end
        elseif next(hbCache) ~= nil then
            for p, data in pairs(hbCache) do
                if p and p.Parent then
                    pcall(function()
                        p.Size = data.size
                        p.Transparency = data.transp
                        p.CanCollide = data.collide
                        p.Massless = data.massless
                    end)
                end
            end
            table.clear(hbCache)
        end

        -- Kill Aura
        if CFG.KillAura and ch and h and hrp and h.Health > 0 then
            local range = CFG.KillAuraRange or 20
            local tool  = ch:FindFirstChildOfClass("Tool")
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LP then continue end
                local tc, th, thrp = GetChar(p)
                if tc and th and thrp and th.Health > 0 then
                    local sameTeam = CFG.TeamCheck and p.Team ~= nil and p.Team == LP.Team
                    if not sameTeam and (hrp.Position - thrp.Position).Magnitude <= range then
                        if tool then
                            pcall(function() tool:Activate() end)
                        else
                            pcall(function() h:ChangeState(Enum.HumanoidStateType.Physics) end)
                        end
                        break
                    end
                end
            end
        end

        -- Ghost Mode
        if CFG.GhostMode and hrp then
            local gd = CFG.GhostDistance or 60
            for _, p in ipairs(Players:GetPlayers()) do
                if p == LP then continue end
                local _, _, thrp = GetChar(p)
                if thrp and (hrp.Position - thrp.Position).Magnitude < gd then
                    if not ghostSaved then ghostSaved = hrp.CFrame end
                    local away = (hrp.Position - thrp.Position)
                    if away.Magnitude < 0.5 then away = Vector3.new(1,0,0) end
                    hrp.CFrame = CFrame.new(hrp.Position + away.Unit * (gd - away.Magnitude + 5))
                    break
                end
            end
        end
    end)

    --================================================--
    -- RENDER STEPPED — ESP, Aim, FOV, Fog, Rainbow
    --================================================--
    RunService.RenderStepped:Connect(function()
        local ok, err = pcall(function()
            -- FOV Circle
            if FOVCircle then
                FOVCircle.Visible = CFG.FOVVisible ~= false
                FOVCircle.Radius   = CFG.FOV or 120
                FOVCircle.Position = Vector2.new(Mouse.X, Mouse.Y)
                FOVCircle.Color    = Library.Accent
            end

            -- Fog
            if CFG.NoFog then pcall(function() Lighting.FogEnd = 9e9 end) end

            -- Rainbow Floor
            if CFG.RainbowFloor then
                local hue = tick() % 5 / 5
                for _, p in ipairs(workspace:GetDescendants()) do
                    if p:IsA("BasePart") and p.Size.X > 50 and p.Size.Z > 50 then
                        p.Color = Color3.fromHSV(hue, 1, 1)
                        if not rainbowParts[p] then rainbowParts[p] = true end
                    end
                end
            end

            -- ESP Players
            for plr, d in pairs(ESP_DATA) do
                local vis = false
                local ch, h, hrp = GetChar(plr)
                if (CFG.ESP or CFG.Tracers or CFG.Chams or CFG.WeaponESP) and ch and h and hrp and h.Health > 0 then
                    local head = ch:FindFirstChild("Head")
                    local tw = head and (head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.7, 0))
                                     or (hrp.Position + Vector3.new(0, 2, 0))
                    local bw = hrp.Position - Vector3.new(0, 3, 0)
                    local ts, ot = Camera:WorldToViewportPoint(tw)
                    local bs, ob = Camera:WorldToViewportPoint(bw)
                    if ot and ob and ts.Z > 0 then
                        vis = true
                        local hg = math.abs(bs.Y - ts.Y); local wd = hg * 0.55
                        local bp = Vector2.new(ts.X - wd / 2, ts.Y)
                        local cx = ts.X; local cy = ts.Y + hg / 2

                        d.box.Size     = Vector2.new(wd, hg)
                        d.box.Position = bp
                        d.box.Visible  = CFG.ESP

                        local dist = math.floor((Camera.CFrame.Position - hrp.Position).Magnitude)
                        local distStr = (CFG.ShowDist ~= false) and (" ["..dist.."m]") or ""
                        local hpStr   = CFG.HealthNum and (" "..math.floor(h.Health).."HP") or ""
                        d.text.Text     = plr.Name .. distStr .. hpStr
                        d.text.Visible  = CFG.ESP
                        d.text.Position = Vector2.new(cx, ts.Y + hg + 4)

                        d.hpBG.From = Vector2.new(bp.X - 6, bp.Y + hg)
                        d.hpBG.To   = Vector2.new(bp.X - 6, bp.Y)
                        d.hpBG.Visible = CFG.ESP

                        d.hpBar.From = d.hpBG.From
                        d.hpBar.To   = Vector2.new(bp.X - 6, bp.Y + hg - (hg * (h.Health / math.max(h.MaxHealth, 1))))
                        d.hpBar.Visible = CFG.ESP

                        d.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        d.tracer.To   = Vector2.new(cx, cy)
                        d.tracer.Visible = CFG.Tracers

                        d.box.Color    = CFG.ESPColor or Library.Accent
                        d.tracer.Color = CFG.ESPColor or Library.Accent

                        -- Weapon ESP
                        if CFG.WeaponESP then
                            local tool = ch:FindFirstChildOfClass("Tool")
                            d.weaponText.Text    = tool and tool.Name or ""
                            d.weaponText.Visible = tool ~= nil
                            d.weaponText.Position = Vector2.new(cx, bs.Y + 4)
                        else
                            d.weaponText.Visible = false
                        end

                        if d.highlight then
                            d.highlight.Enabled = CFG.Chams
                            d.highlight.Adornee = ch
                            d.highlight.FillColor = CFG.ESPColor or Library.Accent
                            d.highlight.OutlineColor = CFG.ESPColor or Library.Accent
                        end
                    end
                end
                if not vis then
                    d.box.Visible = false; d.text.Visible = false
                    d.hpBG.Visible = false; d.hpBar.Visible = false
                    d.tracer.Visible = false; d.weaponText.Visible = false
                    if d.highlight then d.highlight.Enabled = false end
                end
            end

            -- Aimbot
            local shouldAim = CFG.Aimbot and (not CFG.AimKey or aimHeld)
            if shouldAim then
                local target, bestDist = nil, CFG.FOV or 120
                local myTeam = LP.Team
                for _, p in ipairs(Players:GetPlayers()) do
                    if p ~= LP then
                        local tc, th = GetChar(p)
                        if tc and th and th.Health > 0 then
                            local sameTeam = CFG.TeamCheck and p.Team ~= nil and p.Team == myTeam
                            if not sameTeam then
                                local part = GetAim(tc, CFG.AimBone)
                                if part and IsVisibleFromCamera(part) then
                                    local pos, on = Camera:WorldToViewportPoint(part.Position)
                                    if on and pos.Z > 0 then
                                        local m = (Vector2.new(pos.X, pos.Y) - Vector2.new(Mouse.X, Mouse.Y)).Magnitude
                                        if m < bestDist then bestDist = m; target = part end
                                    end
                                end
                            end
                        end
                    end
                end

                if target then
                    local aimPos = target.Position
                    if CFG.Prediction then
                        local vel = target.AssemblyLinearVelocity or Vector3.zero
                        local d   = (aimPos - Camera.CFrame.Position).Magnitude
                        local travel = d / 1500
                        aimPos = aimPos + vel * travel
                    end
                    local af = CFrame.new(Camera.CFrame.Position, aimPos)
                    local alpha = 1 - math.clamp(CFG.Smooth or 0.15, 0.05, 0.95)
                    Camera.CFrame = Camera.CFrame:Lerp(af, alpha)
                end
            end
        end)
        if not ok then warn("[Hub] Render erro:", err) end
    end)

    --================================================--
    -- Triggerbot / AutoShoot (via Mouse)
    --================================================--
    task.spawn(function()
        while task.wait(0.05) do
            if not (CFG.Trigger or CFG.AutoShoot) then continue end
            local target = Mouse.Target
            if target and target.Parent then
                local ch, _, _ = GetChar(LP)
                if ch and target:IsDescendantOf(ch) then continue end
                local plr = Players:GetPlayerFromCharacter(target.Parent)
                if plr then
                    local sameTeam = CFG.TeamCheck and plr.Team ~= nil and plr.Team == LP.Team
                    if not sameTeam then
                        if CFG.Trigger then
                            VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, true,  game, 1)
                            task.wait()
                            VirtualInputManager:SendMouseButtonEvent(Mouse.X, Mouse.Y, 0, false, game, 1)
                        end
                        if CFG.AutoShoot then
                            local tool = ch:FindFirstChildOfClass("Tool")
                            if tool then pcall(function() tool:Activate() end) end
                        end
                    end
                end
            end
        end
    end)


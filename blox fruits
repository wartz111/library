    local function farmRaid()
        if not BF.AutoRaid then return end
        local inRaid = workspace:FindFirstChild("Enemies") and workspace.Enemies:FindFirstChild("RaidBoss")
        local hrp = getHRP()
        
        if not hrp then return end
        if inRaid then
            for _, mob in ipairs(workspace.Enemies:GetChildren()) do
                local mobHrp = getRoot(mob)
                local hum = mob:FindFirstChildOfClass("Humanoid")
                if mobHrp and hum and hum.Health > 0 then
                    flyTo(mobHrp.Position + Vector3.new(0, 7, 0), BF.FlySpeed)
                    hrp.CFrame = CFrame.lookAt(hrp.Position, mobHrp.Position)
                    pcall(function() atk(equip()) end)
                    useSkills()
                    break 
                end
            end
        else
            local cf = getCommF()
            if cf then
                pcall(function() cf:InvokeServer("RaidsNpc", "Select", BF.RaidChip) end)
                local tubePosition = Sea == 3 and Vector3.new(-5000, 300, -6000) or Vector3.new(-6508, 252, -4532)
                flyTo(tubePosition, BF.FlySpeed)
                task.wait(1)
                pcall(function() fireclickdetector(workspace.Map.RaidLab.Button.ClickDetector) end)
            end
        end
    end

    local function farmSeaEvents()
        if not BF.SeaEvents then return end
        local hrp = getHRP()
        if not hrp then return end

        local sb = workspace:FindFirstChild("SeaBeast") or (workspace:FindFirstChild("Enemies") and workspace.Enemies:FindFirstChild("Terrorshark"))
        if sb then
            local mobHrp = getRoot(sb)
            if mobHrp then
                flyTo(mobHrp.Position + Vector3.new(0, 100, 0), BF.FlySpeed)
                hrp.CFrame = CFrame.lookAt(hrp.Position, mobHrp.Position)
                pcall(function() atk(equip()) end)
                useSkills()
            end
        else
            local myBoat = workspace.Boats:FindFirstChild(LP.Name .. "Boat")
            if not myBoat then
                local cf = getCommF()
                if cf then pcall(function() cf:InvokeServer("BuyBoat", BF.BoatName) end); task.wait(2) end
            else
                local seat = myBoat:FindFirstChild("VehicleSeat")
                if seat and seat.Occupant == nil then
                    hrp.CFrame = seat.CFrame; task.wait(0.5)
                end
                local dangerZone = Vector3.new(10000, 20, 10000) 
                if (hrp.Position - dangerZone).Magnitude > 500 then
                    myBoat:SetPrimaryPartCFrame(CFrame.new(myBoat.PrimaryPart.Position, dangerZone) * CFrame.new(0,0,-50))
                end
            end
        end
    end


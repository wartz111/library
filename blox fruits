--!nocheck
--================================================--
-- PREMIUM HUB v11 - BLOX FRUITS MODULE
--================================================--
return function(ctx)
    local Library = ctx.Library; local CFG = ctx.CFG; local Window = ctx.Window
    local LP = ctx.LP; local GetChar = ctx.GetChar; local getCommF = ctx.getCommF
    local IS_BLOX_FRUITS = ctx.L.IS_BLOX_FRUITS
    local SetFlyFarmStateMoving = ctx.SetFlyFarmStateMoving

    if not IS_BLOX_FRUITS then return end

    --================================================--
    -- DADOS
    --================================================--
    local function Q(minLevel, mob, quest, index, npc, pos)
        return { minLevel = minLevel, mob = mob, quest = quest, index = index, npc = npc, pos = pos }
    end
    local QUESTS = {
        Q(1,   "Bandit",              "BanditQuest1",  1, "Pirate Adventurer",     Vector3.new(1059,16,1547)),
        Q(10,  "Monkey",              "JungleQuest",   1, "Adventurer",            Vector3.new(-1599,22,154)),
        Q(15,  "Gorilla",             "JungleQuest",   2, "Adventurer",            Vector3.new(-1599,22,154)),
        Q(30,  "Pirate",              "BuggyQuest1",   1, "Pirate Adventurer",     Vector3.new(-1140,15,3930)),
        Q(40,  "Brute",               "BuggyQuest1",   2, "Pirate Adventurer",     Vector3.new(-1140,15,3930)),
        Q(60,  "Desert Bandit",       "DesertQuest",   1, "Desert Adventurer",     Vector3.new(954,6,4070)),
        Q(75,  "Desert Officer",      "DesertQuest",   2, "Desert Adventurer",     Vector3.new(954,6,4070)),
        Q(90,  "Snow Bandit",         "SnowQuest",     1, "Villager",              Vector3.new(1047,21,-5430)),
        Q(100, "Snowman",             "SnowQuest",     2, "Villager",              Vector3.new(1047,21,-5430)),
        Q(120, "Chief Petty Officer", "MarineQuest2",  1, "Marine",                Vector3.new(-2875,24,3326)),
        Q(150, "Sky Bandit",          "SkyQuest",      1, "Sky Adventurer",        Vector3.new(-4841,23,-846)),
        Q(175, "Dark Master",         "SkyQuest",      2, "Sky Adventurer",        Vector3.new(-4841,23,-846)),
        Q(190, "Prisoner",            "PrisonerQuest", 1, "Jail Keeper",           Vector3.new(4867,4,740)),
        Q(210, "Dangerous Prisoner",  "PrisonerQuest", 2, "Jail Keeper",           Vector3.new(4867,4,740)),
        Q(250, "Toga Warrior",        "ColosseumQuest",1, "Colosseum Quest Giver", Vector3.new(-1540,8,151)),
        Q(275, "Gladiator",           "ColosseumQuest",2, "Colosseum Quest Giver", Vector3.new(-1540,8,151)),
        Q(300, "Military Soldier",    "MagmaQuest",    1, "The Mayor",             Vector3.new(-5300,9,8500)),
        Q(325, "Military Spy",        "MagmaQuest",    2, "The Mayor",             Vector3.new(-5300,9,8500)),
        Q(375, "Fishman Warrior",     "FishmanQuest",  1, "King Neptune",          Vector3.new(-3083,7,-9780)),
        Q(400, "Fishman Commando",    "FishmanQuest",  2, "King Neptune",          Vector3.new(-3083,7,-9780)),
        Q(450, "God's Guard",         "SkyExp1Quest",  1, "Mole",                  Vector3.new(-4841,23,-2450)),
        Q(475, "Shanda",              "SkyExp1Quest",  2, "Mole",                  Vector3.new(-4841,23,-2450)),
        Q(525, "Royal Squad",         "SkyExp2Quest",  1, "Sky Quest Giver 2",     Vector3.new(-5020,27,-2270)),
        Q(550, "Royal Soldier",       "SkyExp2Quest",  2, "Sky Quest Giver 2",     Vector3.new(-5020,27,-2270)),
        Q(625, "Galley Pirate",       "FountainQuest", 1, "Freezeburg Quest Giver",Vector3.new(5367,6,4050)),
        Q(650, "Galley Captain",      "FountainQuest", 2, "Freezeburg Quest Giver",Vector3.new(5367,6,4050)),
    }

    local BF = {
        Enabled = false, FarmThread = nil,
        SelectedQuest = nil,   -- quest manual (nil = automatico por nivel)
        FreeMob = nil,         -- farm sem quest (nome do mob)
        BossMob = nil,         -- farm de boss (nome do boss)
        FlyFarm = true, FlySpeed = 60, FastAttack = true, BringMobs = false,
        WeaponType = "Melee", Height = 6,
        QuestCooldown = 0, LastNotify = 0,
    }
    local FlyFarmMoving = false
    SetFlyFarmStateMoving(function() return FlyFarmMoving end)

    --================================================--
    -- UTILIDADES
    --================================================--
    local function questLabel(q) return q.mob.." ("..q.quest.." #"..q.index..")" end

    local function getLvl()
        local ok, l = pcall(function() return LP.Data.Level.Value end)
        if ok and type(l) == "number" then return l end
        return nil
    end
    local function hasQ()
        local ok, v = pcall(function() return LP.PlayerGui.Main.Quest.Visible end)
        return ok and v == true
    end
    local function getQT()
        local ok, t = pcall(function() return LP.PlayerGui.Main.Quest.Container.QuestTitle.Title.Text end)
        return ok and t or nil
    end
    -- compara ignorando plural (Snowman/Snowmen, Spy/Spies)
    local function questMatches(q)
        local t = getQT()
        if not t or t == "" then return true end
        local stem = q.mob:lower()
        stem = stem:sub(1, math.max(3, #stem - 2))
        return t:lower():find(stem, 1, true) ~= nil
    end
    local function pickQ(l)
        local best
        for _, q in ipairs(QUESTS) do if l >= q.minLevel then best = q end end
        return best
    end
    local function sendQ(name, idx)
        local cf = getCommF(); if not cf then return false end
        return pcall(function() cf:InvokeServer("StartQuest", name, idx) end)
    end
    local function abandonQ()
        local cf = getCommF(); if not cf then return end
        pcall(function() cf:InvokeServer("AbandonQuest") end)
    end
    local function getHRP()
        local c = LP.Character
        return c and c:FindFirstChild("HumanoidRootPart")
    end
    local function tp(pos)
        local h = getHRP()
        if h then h.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0)) end
    end
    local function notify(title, msg, kind, dur)
        if os.clock() - BF.LastNotify < 1.5 then return end
        BF.LastNotify = os.clock()
        pcall(function() Library:Notify({Title = title, Message = msg, Type = kind or "info", Duration = dur or 1.5}) end)
    end

    --================================================--
    -- SPAWNS (workspace._WorldOrigin.EnemySpawns)
    --================================================--
    local SpawnsByMob = {}   -- ["bandit"] = { {pos, level, boss, name} }
    local SpawnNames = {}    -- ["bandit"] = "Bandit" (nome original)

    local function parseName(name)
        local mob, lv, rest = name:match("^(.-)%s*%[Lv%.%s*(%d+)%](.*)$")
        if not mob then return nil end
        return mob, tonumber(lv), (rest or ""):find("Boss") ~= nil
    end

    local BOSS_NAMES = {}
    for _, n in ipairs({"chef","cyborg","fishman lord","greybeard","ice admiral","magma admiral","magma general",
        "mob leader","mob boss","sky warlord","lightning god","yeti","vice admiral","saber expert","the gorilla king",
        "bobby","the saw","warden","chief warden","swan","diamond","jeremy","fajita","don swan","smoke admiral",
        "cursed captain","darkbeard","order","awakened ice admiral","tide keeper"}) do BOSS_NAMES[n] = true end
    local JUNK = { part = true, humanoidrootpart = true, model = true }

    local function addSpawn(mob, lv, boss, pos)
        local k = mob:lower()
        SpawnsByMob[k] = SpawnsByMob[k] or {}
        for _, sp in ipairs(SpawnsByMob[k]) do
            if (sp.pos - pos).Magnitude < 5 then return end -- duplicado
        end
        SpawnNames[k] = SpawnNames[k] or mob
        table.insert(SpawnsByMob[k], { pos = pos, level = lv or 0, boss = boss })
    end

    local function pivotPos(inst)
        local ok, cf = pcall(function() return inst:GetPivot() end)
        return ok and cf and cf.Position or nil
    end

    local function scanSpawns()
        table.clear(SpawnsByMob); table.clear(SpawnNames)

        -- 1) workspace._WorldOrigin.EnemySpawns (tem nivel e [Boss])
        local origin = workspace:FindFirstChild("_WorldOrigin")
        local folder = origin and origin:FindFirstChild("EnemySpawns")
        if folder then
            for _, sp in ipairs(folder:GetChildren()) do
                local mob, lv, boss = parseName(sp.Name)
                local pos = mob and pivotPos(sp)
                if pos then addSpawn(mob, lv, boss, pos) end
            end
        end

        -- 2) ReplicatedStorage.FortBuilderReplicatedSpawnPositionsFolder (so o nome)
        local rs = game:GetService("ReplicatedStorage"):FindFirstChild("FortBuilderReplicatedSpawnPositionsFolder")
        if rs then
            for _, sp in ipairs(rs:GetChildren()) do
                local name = sp.Name
                if not tonumber(name) and not JUNK[name:lower()] then
                    local mob = parseName(name) or name
                    local pos = pivotPos(sp)
                    if pos then addSpawn(mob, nil, BOSS_NAMES[mob:lower()] == true, pos) end
                end
            end
        end
        return next(SpawnsByMob) ~= nil
    end

    local function nearestSpawn(mobName, from)
        local list = SpawnsByMob[mobName:lower()]
        if not list then return nil end
        local best, bestD
        for _, sp in ipairs(list) do
            local d = (sp.pos - from).Magnitude
            if not bestD or d < bestD then best, bestD = sp, d end
        end
        return best
    end

    -- lista de mobs normais / bosses para dropdowns, ordenados por nivel
    local function buildMobLists()
        local normals, bosses = {}, {}
        for k, list in pairs(SpawnsByMob) do
            local entry = { name = SpawnNames[k], level = list[1].level }
            if list[1].boss then table.insert(bosses, entry) else table.insert(normals, entry) end
        end
        local function cmp(a, b)
            if a.level ~= b.level then return a.level < b.level end
            return a.name < b.name
        end
        table.sort(normals, cmp); table.sort(bosses, cmp)
        local nOpts, bOpts, nMap, bMap = { "Nenhum" }, { "Nenhum" }, {}, {}
        for _, e in ipairs(normals) do
            local lbl = e.name..(e.level > 0 and (" [Lv. "..e.level.."]") or "")
            table.insert(nOpts, lbl); nMap[lbl] = e.name
        end
        for _, e in ipairs(bosses) do
            local lbl = e.name..(e.level > 0 and (" [Lv. "..e.level.."]") or "")
            table.insert(bOpts, lbl); bMap[lbl] = e.name
        end
        return nOpts, bOpts, nMap, bMap
    end

    --================================================--
    -- INIMIGOS
    --================================================--
    local function baseName(n)
        local b = parseName(n)
        return (b or n):lower()
    end

    -- normaliza: tira nivel, simbolos, plural (Snowmen->snowman, Spies->spy)
    local function norm(s)
        local b = parseName(s)
        s = (b or s):lower()
        return (s:gsub("[^%a%d]", ""))
    end
    local function stemOf(n)
        n = n:gsub("ies$", "y"):gsub("men$", "man"):gsub("s$", "")
        return n
    end
    local function getRoot(m)
        local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
        if not r then
            local hum = m:FindFirstChildOfClass("Humanoid")
            r = hum and hum.RootPart
        end
        return r
    end

    -- mobs "estacionados" (longe do spawn / na origem) nao contam
    local function validPos(mobName, pos)
        if pos.Magnitude < 20 then return false end
        local me = getHRP()
        if me and (me.Position - pos).Magnitude < 300 then return true end
        local list = SpawnsByMob[mobName:lower()]
        if not list or #list == 0 then return true end
        for _, sp in ipairs(list) do
            if (sp.pos - pos).Magnitude < 300 then return true end
        end
        return false
    end

    -- 1a passada: nome exato (normalizado). 2a: parcial, so se estiver perto
    local function getMobs(mobName)
        local exact, fuzzy = {}, {}
        local enemies = workspace:FindFirstChild("Enemies")
        if not enemies or not mobName then return exact end
        local me = getHRP()
        local tN = norm(mobName); local tS = stemOf(tN)
        for _, m in ipairs(enemies:GetChildren()) do
            local hum = m:FindFirstChildOfClass("Humanoid")
            local root = getRoot(m)
            if hum and hum.Health > 0 and root and validPos(mobName, root.Position) then
                local n = norm(m.Name); local s = stemOf(n)
                if n == tN or s == tS then
                    table.insert(exact, m)
                elseif #s >= 4 and #tS >= 4 and (s:find(tS, 1, true) or tS:find(s, 1, true))
                    and me and (root.Position - me.Position).Magnitude < 250 then
                    table.insert(fuzzy, m)
                end
            end
        end
        if #exact > 0 then return exact end
        return fuzzy
    end

    -- qualquer inimigo vivo perto (ultimo recurso)
    local function nearestAnyEnemy(from, radius)
        local enemies = workspace:FindFirstChild("Enemies")
        if not enemies then return nil end
        local best, bestD
        for _, m in ipairs(enemies:GetChildren()) do
            local hum = m:FindFirstChildOfClass("Humanoid")
            local root = getRoot(m)
            if hum and hum.Health > 0 and root and root.Position.Magnitude > 20 then
                local d = (root.Position - from).Magnitude
                if d <= radius and (not bestD or d < bestD) then best, bestD = m, d end
            end
        end
        return best
    end

    -- percorre os spawns do mob, do mais perto de "ref" para o mais longe
    local SpawnIdx = {}
    local function pickSpawn(mobName, ref)
        local list = SpawnsByMob[mobName:lower()]
        if not list or #list == 0 then return nil end
        local sorted = {}
        for _, sp in ipairs(list) do table.insert(sorted, sp) end
        table.sort(sorted, function(x, y) return (x.pos - ref).Magnitude < (y.pos - ref).Magnitude end)
        local k = mobName:lower()
        local i = ((SpawnIdx[k] or 0) % #sorted) + 1
        return sorted[i], k
    end

    --================================================--
    -- ARMA
    --================================================--
    local function findTool(tip)
        local c = LP.Character; if not c then return nil end
        for _, x in ipairs(c:GetChildren()) do
            if x:IsA("Tool") and x.ToolTip == tip then return x end
        end
        for _, x in ipairs(LP.Backpack:GetChildren()) do
            if x:IsA("Tool") and x.ToolTip == tip then return x end
        end
        return nil
    end
    local function equip()
        local c = LP.Character; if not c then return nil end
        local t = findTool(BF.WeaponType)
        if not t then
            t = c:FindFirstChildOfClass("Tool")
            if not t then
                for _, x in ipairs(LP.Backpack:GetChildren()) do
                    if x:IsA("Tool") then t = x; break end
                end
            end
        end
        if t and t.Parent ~= c then t.Parent = c end
        return t
    end
    local VU = game:GetService("VirtualUser")
    local function atk(t)
        if t then pcall(function() t:Activate() end) end
        pcall(function() VU:CaptureController(); VU:ClickButton1(Vector2.new(900, 500)) end)
    end

    --================================================--
    -- MOVIMENTO
    --================================================--
    local function setNoCollide(ch, saved)
        for _, p in ipairs(ch:GetDescendants()) do
            if p:IsA("BasePart") then
                if saved and saved[p] == nil then saved[p] = p.CanCollide end
                p.CanCollide = false
            end
        end
    end
    local function restoreCollide(saved)
        if CFG.Noclip then return end
        for p, v in pairs(saved) do
            if p and p.Parent then pcall(function() p.CanCollide = v end) end
        end
    end

    local function flyTo(target, speed, timeout)
        local ch, h, hrp = GetChar(LP)
        if not hrp or not h then return false end
        FlyFarmMoving = true
        local oAR, oPS = h.AutoRotate, h.PlatformStand
        local saved = {}
        local reached = false

        local ok, err = pcall(function()
            h.PlatformStand = true; h.AutoRotate = false
            setNoCollide(ch, saved)
            local deadline = os.clock() + (timeout or 15)
            while BF.Enabled and os.clock() < deadline do
                if not hrp.Parent then break end
                local mp = hrp.Position
                local d = target - mp
                if d.Magnitude < 4 then reached = true; break end
                hrp.AssemblyLinearVelocity = d.Unit * speed
                local fd = Vector3.new(d.X, 0, d.Z)
                if fd.Magnitude > 0.1 then hrp.CFrame = CFrame.new(mp, mp + fd.Unit) end
                task.wait(0.03)
            end
        end)

        -- limpeza sempre executa
        if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = Vector3.zero end
        if h and h.Parent then h.PlatformStand = oPS; h.AutoRotate = oAR end
        restoreCollide(saved)
        FlyFarmMoving = false
        if not ok then warn("flyTo:", err) end
        return reached
    end

    local function goTo(pos, timeout)
        if BF.FlyFarm then return flyTo(pos, BF.FlySpeed, timeout or 20) end
        tp(pos); task.wait(0.3); return true
    end

    --================================================--
    -- FARM
    --================================================--
    -- retorna: mobName, quest (ou nil)
    local function resolveTarget()
        if BF.BossMob then return BF.BossMob, nil end
        if BF.FreeMob then return BF.FreeMob, nil end
        local l = getLvl(); if not l then return nil end
        local q = BF.SelectedQuest or pickQ(l)
        if not q then return nil end
        return q.mob, q
    end

    -- garante quest correta ativa. true = pode atacar
    local function ensureQuest(q)
        if hasQ() then
            if questMatches(q) then return true end
            if BF.QuestCooldown > os.clock() then return false end
            abandonQ()
            BF.QuestCooldown = os.clock() + 1.5
            return false
        end
        if BF.QuestCooldown > os.clock() then return false end
        local h = getHRP(); if not h then return false end
        if (h.Position - q.pos).Magnitude > 15 then
            notify("Auto Farm", "Indo ate "..q.npc)
            goTo(q.pos + Vector3.new(0, 5, 0), 20)
        end
        sendQ(q.quest, q.index)
        task.wait(0.5)
        BF.QuestCooldown = os.clock() + 0.8
        return false
    end

    local function bringNearby(mobName, center)
        for _, m in ipairs(getMobs(mobName)) do
            local mh = getRoot(m)
            if mh and (mh.Position - center).Magnitude < 60 then
                pcall(function()
                    mh.CFrame = CFrame.new(center + Vector3.new(0, -2, 0))
                    mh.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end

    local function engage(mob, q)
        local ch, h = GetChar(LP)
        if not ch or not h then return end
        local oPS = h.PlatformStand
        local saved = {}
        FlyFarmMoving = true
        pcall(function()
            h.PlatformStand = true
            local t0 = os.clock()
            while BF.Enabled and os.clock() - t0 < 12 do
                local mh = getRoot(mob)
                local mhum = mob:FindFirstChildOfClass("Humanoid")
                if not mob.Parent or not mh or not mhum or mhum.Health <= 0 then break end
                local hrp = getHRP()
                if not hrp or h.Health <= 0 then break end
                if q and not hasQ() then break end

                setNoCollide(ch, saved)
                local above = mh.Position + Vector3.new(0, BF.Height, 0)
                hrp.CFrame = CFrame.new(above, mh.Position)
                hrp.AssemblyLinearVelocity = Vector3.zero
                if BF.BringMobs then bringNearby(mob.Name:match("^(.-)%s*%[") or mob.Name, mh.Position) end

                local tool = equip()
                atk(tool)
                if BF.FastAttack then task.wait(0.05); atk(tool) end
                task.wait(0.1)
            end
        end)
        if h and h.Parent then h.PlatformStand = oPS end
        restoreCollide(saved)
        FlyFarmMoving = false
    end

    local function huntMob(mobName, fallbackPos)
        local h = getHRP(); if not h then return end
        local mobs = getMobs(mobName)

        -- nenhum mob com o nome certo
        if #mobs == 0 then
            -- ultimo recurso: ataca qualquer inimigo vivo perto
            local near = nearestAnyEnemy(h.Position, 70)
            if near then return near end

            -- percorre os spawns perto do NPC, um por vez
            local ref = fallbackPos or h.Position
            local sp, key = pickSpawn(mobName, ref)
            local dest = sp and (sp.pos + Vector3.new(0, 10, 0))
                or (fallbackPos and (fallbackPos + Vector3.new(0, 5, 0)))
            if dest then
                if (h.Position - dest).Magnitude > 25 then
                    notify("Auto Farm", "Procurando "..mobName)
                    goTo(dest, 20)
                else
                    -- chegou e nao tem mob: espera respawn e vai ao proximo spawn
                    task.wait(1.5)
                    if key then SpawnIdx[key] = (SpawnIdx[key] or 0) + 1 end
                end
            end
            return
        end

        table.sort(mobs, function(a, b)
            local ah, bh = getRoot(a), getRoot(b)
            if not ah or not bh then return false end
            return (h.Position - ah.Position).Magnitude < (h.Position - bh.Position).Magnitude
        end)
        local mob = mobs[1]
        local mh = getRoot(mob)
        if not mh then return end

        if (h.Position - mh.Position).Magnitude > 20 then
            goTo(mh.Position + Vector3.new(0, BF.Height, 0), 15)
        end
        return mob
    end

    local function farmTick()
        if not BF.Enabled then return end
        if not getHRP() then return end
        local mobName, q = resolveTarget()
        if not mobName then return end

        if q and not ensureQuest(q) then return end

        local mob = huntMob(mobName, q and q.pos)
        if mob then engage(mob, q) end
    end

    local function startFarm()
        if BF.FarmThread then return end
        BF.FarmThread = task.spawn(function()
            while BF.Enabled do
                local ok, err = pcall(farmTick)
                if not ok then warn("farmTick:", err); FlyFarmMoving = false end
                task.wait(0.15)
            end
            BF.FarmThread = nil
        end)
    end

    --================================================--
    -- UI
    --================================================--
    local spawnsOk = scanSpawns()
    local nOpts, bOpts, nMap, bMap = buildMobLists()

    local bfTab = Window:AddTab("Blox Fruits", "◇")
    local sFarm = bfTab:AddSection("Auto Farm")
    local bfStatus = sFarm:AddLabel("Verificando...")
    task.spawn(function()
        task.wait(2)
        bfStatus:Set(spawnsOk and "[OK] Blox Fruits + spawns carregados" or "[!] EnemySpawns nao encontrado (usando NPC)")
    end)
    local statusLbl = sFarm:AddLabel("Status: parado")
    local mobCountLbl = sFarm:AddLabel("Mobs: --")

    local function currentModeText()
        if BF.BossMob then return "BOSS "..BF.BossMob end
        if BF.FreeMob then return "MOB "..BF.FreeMob end
        local q = BF.SelectedQuest or pickQ(getLvl() or 0)
        return q and questLabel(q) or "nenhuma"
    end
    local function updStatus()
        local l = getLvl() or 0
        if BF.Enabled then statusLbl:Set("FARMANDO - Nv "..l.." -> "..currentModeText())
        else statusLbl:Set("Parado") end
    end

    sFarm:AddToggle({ Name="Auto Farm", Default=false, Flag="AutoFarm", Callback=function(v)
        BF.Enabled = v
        if v then
            if not next(SpawnsByMob) then scanSpawns() end
            startFarm()
            Library:Notify({Title="Auto Farm", Message="Iniciado", Type="success"})
        else
            Library:Notify({Title="Auto Farm", Message="Parado", Type="warn"})
        end
        updStatus()
    end })
    sFarm:AddToggle({ Name="Fly Farm", Default=true, Flag="FlyFarm", Callback=function(v) BF.FlyFarm = v end })
    sFarm:AddSlider({ Name="Velocidade Voo Farm", Min=20, Max=200, Default=60, Step=5, Suffix=" sp", Flag="FlyFarmSpeed", Callback=function(v) BF.FlySpeed = v end })
    sFarm:AddToggle({ Name="Fast Attack", Default=true, Flag="FastAttack", Callback=function(v) BF.FastAttack = v end })
    sFarm:AddSlider({ Name="Altura sobre o mob", Min=2, Max=20, Default=6, Step=1, Suffix=" st", Flag="FarmHeight", Callback=function(v) BF.Height = v end })
    sFarm:AddToggle({ Name="Bring Mobs", Default=false, Flag="BringMobs", Callback=function(v) BF.BringMobs = v end })
    sFarm:AddDropdown({ Name="Arma", Options={"Melee","Sword","Blox Fruit","Gun"}, Default="Melee", Flag="WeaponType", Callback=function(v) BF.WeaponType = v or "Melee" end })

    sFarm:AddToggle({ Name="ESP Enemies", Default=false, Flag="ESPEnemies", Callback=function(v)
        if not v then return end
        task.spawn(function()
            local dr = {}
            while Library.Flags.ESPEnemies do
                local e = workspace:FindFirstChild("Enemies")
                if e then
                    for _, m in ipairs(e:GetChildren()) do
                        if m:FindFirstChild("HumanoidRootPart") and not dr[m] then
                            local b = Drawing.new("Square")
                            b.Thickness = 1; b.Color = Color3.fromRGB(255,60,60); b.Filled = false; b.Visible = true
                            dr[m] = b
                        end
                    end
                end
                for mob, b in pairs(dr) do
                    if mob and mob.Parent and mob:FindFirstChild("HumanoidRootPart") then
                        local p, on = ctx.Camera:WorldToViewportPoint(mob.HumanoidRootPart.Position)
                        b.Position = Vector2.new(p.X-20, p.Y-40); b.Size = Vector2.new(40,80); b.Visible = on
                    else
                        pcall(function() b:Remove() end); dr[mob] = nil
                    end
                end
                task.wait(0.05)
            end
            for _, b in pairs(dr) do pcall(function() b:Remove() end) end
        end)
    end })

    sFarm:AddButton({ Name="Atualizar Status", Callback=updStatus })
    sFarm:AddButton({ Name="Reescanear Spawns", Callback=function()
        local ok = scanSpawns()
        Library:Notify({Title="Spawns", Message=ok and "Spawns atualizados (reabra o hub p/ atualizar listas)" or "Pasta nao encontrada", Type=ok and "success" or "warn"})
    end })
    sFarm:AddButton({ Name="Mobs sem quest (console)", Callback=function()
        if not scanSpawns() then Library:Notify({Title="Debug", Message="Sem EnemySpawns", Type="warn"}); return end
        local known = {}
        for _, q in ipairs(QUESTS) do known[q.mob:lower()] = true end
        print("=== MOBS SEM QUEST ===")
        for k, list in pairs(SpawnsByMob) do
            if not known[k] then
                print(("  %s | Lv %d | %s | %d spawns"):format(SpawnNames[k], list[1].level, list[1].boss and "BOSS" or "normal", #list))
            end
        end
        print("=== QUESTS SEM SPAWN ===")
        for _, q in ipairs(QUESTS) do
            if not SpawnsByMob[q.mob:lower()] then print("  "..q.mob) end
        end
        Library:Notify({Title="Debug", Message="Listado no F9", Type="success"})
    end })

    sFarm:AddButton({ Name="Debug alvo atual (console)", Callback=function()
        local mobName, q = resolveTarget()
        print("=== DEBUG ALVO ===")
        print("alvo:", mobName, "| normalizado:", mobName and norm(mobName))
        print("achados por nome:", mobName and #getMobs(mobName) or 0)
        print("spawns na pasta:", mobName and SpawnsByMob[mobName:lower()] and #SpawnsByMob[mobName:lower()] or 0)
        local h = getHRP()
        local enemies = workspace:FindFirstChild("Enemies")
        if enemies and mobName then
            print("todos com esse nome (valido = perto de um spawn):")
            for _, m in ipairs(enemies:GetChildren()) do
                local r = getRoot(m)
                if r and norm(m.Name) == norm(mobName) then
                    print(("  %s pos=%s valido=%s"):format(m.Name, tostring(r.Position), tostring(validPos(mobName, r.Position))))
                end
            end
        end
        if enemies and h then
            print("inimigos vivos num raio de 150:")
            for _, m in ipairs(enemies:GetChildren()) do
                local r = getRoot(m)
                local hu = m:FindFirstChildOfClass("Humanoid")
                if r and hu and hu.Health > 0 and (r.Position - h.Position).Magnitude < 150 then
                    print(("  '%s' -> '%s' (%.0f studs)"):format(m.Name, norm(m.Name), (r.Position - h.Position).Magnitude))
                end
            end
        end
        Library:Notify({Title="Debug", Message="Veja o F9", Type="success"})
    end })

    local sManual = bfTab:AddSection("Modo de Farm")
    local qOpts = { "Automatico" }
    for _, q in ipairs(QUESTS) do table.insert(qOpts, questLabel(q)) end
    sManual:AddDropdown({ Name="Escolher Quest", Options=qOpts, Default="Automatico", Flag="ManualQuest", Callback=function(v)
        BF.SelectedQuest = nil
        if v and v ~= "Automatico" then
            for _, q in ipairs(QUESTS) do if questLabel(q) == v then BF.SelectedQuest = q; break end end
        end
        updStatus()
    end })
    sManual:AddDropdown({ Name="Farm sem Quest (mob)", Options=nOpts, Default="Nenhum", Flag="FreeMob", Callback=function(v)
        BF.FreeMob = (v and v ~= "Nenhum") and nMap[v] or nil
        updStatus()
    end })
    sManual:AddDropdown({ Name="Farm de Boss", Options=bOpts, Default="Nenhum", Flag="BossMob", Callback=function(v)
        BF.BossMob = (v and v ~= "Nenhum") and bMap[v] or nil
        updStatus()
    end })
    sManual:AddButton({ Name="Teleportar ate NPC", Callback=function()
        local q = BF.SelectedQuest or pickQ(getLvl() or 1)
        if q then tp(q.pos); Library:Notify({Title="Teleport", Message="Indo", Type="info"}) end
    end })
    sManual:AddButton({ Name="Pegar Quest", Callback=function()
        local q = BF.SelectedQuest or pickQ(getLvl() or 1)
        if q then sendQ(q.quest, q.index); Library:Notify({Title="Quest", Message="Aceita", Type="success"}) end
    end })

    local sInfo = bfTab:AddSection("Info")
    local infoLbl = sInfo:AddLabel("Carregando...")

    -- loop unico de UI
    local alive = true
    task.spawn(function()
        while alive do
            pcall(function()
                local mobName, q = resolveTarget()
                local enemies = workspace:FindFirstChild("Enemies")
                local count, matches = 0, 0
                if enemies then
                    for _, m in ipairs(enemies:GetChildren()) do
                        local hu = m:FindFirstChildOfClass("Humanoid")
                        if hu and hu.Health > 0 then
                            count += 1
                            if mobName and baseName(m.Name) == mobName:lower() then matches += 1 end
                        end
                    end
                end
                mobCountLbl:Set("Mobs: "..count.." total | "..(mobName or "?")..": "..matches)

                local l = getLvl() or "?"
                local t = getQT()
                infoLbl:Set("Nv: "..l.." | Quest: "..(hasQ() and (t or "ativa") or "nenhuma"))
                updStatus()
            end)
            task.wait(1)
        end
    end)

    -- permite parar tudo ao descarregar o hub
    return function()
        alive = false
        BF.Enabled = false
    end
end

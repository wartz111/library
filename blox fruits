    -- saida de debug: F9 + console do executor + clipboard + label na UI
    local function emit(lines)
        local text = table.concat(lines, "\n")
        for _, l in ipairs(lines) do print(l) end
        pcall(function() rconsoleprint(text.."\n") end)
        local copied = pcall(function() setclipboard(text) end)
        local short = {}
        for i = 1, math.min(#lines, 4) do short[i] = lines[i] end
        pcall(function() dbgLbl:Set(table.concat(short, " | ")) end)
        pcall(function()
            Library:Notify({Title="Debug", Message = copied and "Copiado! Cole aqui no chat (Ctrl+V)" or "Resumo no label (F9/console pode nao mostrar)", Type="success", Duration=4})
        end)
    end


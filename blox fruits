        -- procura o inimigo mais proximo cujo nome contem (ou e igual a) um dos padroes
        local function findEnemyLike(patterns, exact)
            local enemies = workspace:FindFirstChild("Enemies")
            if not enemies then return nil end
            local h = getHRP()
            local best, bd
            for _, m in ipairs(enemies:GetChildren()) do
                local hum = m:FindFirstChildOfClass("Humanoid")
                local r = getRoot(m)
                if hum and hum.Health > 0 and r then
                    local n = (m.Name:match("^(.-)%s*%[") or m.Name):lower()
                    for _, p in ipairs(patterns) do
                        if (exact and n == p) or (not exact and n:find(p, 1, true)) then
                            local d = h and (h.Position - r.Position).Magnitude or 0
                            if not bd or d < bd then best, bd = m, d end
                            break
                        end
                    end
                end
            end
            return best
        end

        local function reach(mob)
            local h, r = getHRP(), getRoot(mob)
            if not h or not r then return false end
            if (h.Position - r.Position).Magnitude > 20 then

    local function findTool(tip)
        local c = LP.Character; if not c then return nil end
        for _, x in ipairs(c:GetChildren()) do
            if x:IsA("Tool") and x.ToolTip == tip then return x end
        end
        for _, x in ipairs(LP.Backpack:GetChildren()) do
            if x:IsA("Tool") and x.ToolTip == tip then return x end
        end
        return nil
    end

    local function equip(tipOverride)
        local c = LP.Character; if not c then return nil end
        local t = findTool(tipOverride or BF.WeaponType)
        if not t then
            t = c:FindFirstChildOfClass("Tool")
            if not t then
                for _, x in ipairs(LP.Backpack:GetChildren()) do
                    if x:IsA("Tool") then t = x; break end
                end
            end
        end
        if t and t.Parent ~= c then
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:EquipTool(t) end) end
            if t.Parent ~= c then t.Parent = c end
        end
        return t
    end

    -- Attack No Animation (RegisterAttack / RegisterHit, igual ao Banana Hub)
    local function netHit()
        local ch = LP.Character; if not ch then return end
        local tool = ch:FindFirstChildOfClass("Tool"); if not tool then return end
        local enemies = workspace:FindFirstChild("Enemies"); if not enemies then return end
        local pivot = ch:GetPivot().Position
        local inRange = {}
        for _, e in ipairs(enemies:GetChildren()) do
            local r = e:FindFirstChild("HumanoidRootPart")
            local hum = e:FindFirstChildOfClass("Humanoid")
            if r and hum and hum.Health > 0 and (r.Position - pivot).Magnitude <= 60 then inRange[#inRange + 1] = e end
        end
        if #inRange == 0 then return end
        local lc = tool:FindFirstChild("LeftClickRemote")
        if lc then
            local n = 1
            for _, e in ipairs(inRange) do
                lc:FireServer((e.HumanoidRootPart.Position - pivot).Unit, n)
                n = n + 1
            end
        else
            local targets, main = {}, nil
            for _, e in ipairs(inRange) do
                if not e:GetAttribute("IsBoat") then
                    local head = e:FindFirstChild("Head")
                    if head then targets[#targets + 1] = { e, head }; main = head end
                end
            end
            local mods = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
            local net = mods and mods:FindFirstChild("Net")
            if main and net then
                local a, h = net:FindFirstChild("RE/RegisterAttack"), net:FindFirstChild("RE/RegisterHit")
                if a and h then a:FireServer(0.1); h:FireServer(main, targets) end
            end
        end
    end


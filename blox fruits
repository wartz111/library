    -- TWEEN FLY PRO (Substitui AssemblyLinearVelocity)
    local function flyTo(target, speed, timeout)
        local ch, h, hrp = GetChar(LP)
        if not hrp or not h then return false end

        local dist = (target - hrp.Position).Magnitude
        local tweenTime = dist / math.max(speed, 50)
        timeout = math.max(timeout or 0, tweenTime + 2)

        FlyFarmMoving = true
        local oAR, oPS = h.AutoRotate, h.PlatformStand
        local saved = {}

        local ok, err = pcall(function()
            h.PlatformStand = true
            h.AutoRotate = false
            setNoCollide(ch, saved)

            local tweenInfo = TweenInfo.new(tweenTime, Enum.EasingStyle.Linear)
            local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(target)})
            tween:Play()

            local deadline = os.clock() + timeout
            while flyActive() and tween.PlaybackState == Enum.PlaybackState.Playing and os.clock() < deadline do
                task.wait(0.1)
            end
            tween:Cancel()
        end)

        if hrp and hrp.Parent then hrp.AssemblyLinearVelocity = Vector3.zero end
        if h and h.Parent then h.PlatformStand = oPS; h.AutoRotate = oAR end
        restoreCollide(saved)
        FlyFarmMoving = false
        
        return (hrp.Position - target).Magnitude < 10
    end


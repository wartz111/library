    local function questMatches(q)
        local t = getQT()
        if not t or t == "" then return true end
        -- Quest title no Blox Fruits eh o campo "Name" da quest
        -- (ex: "Bandits", "Monkeys", "Gorillas", "Snow Bandit", "Yeti"...)
        -- Mobs como "The Gorilla King" -> Name = "Gorilla King", entao comparamos
        -- por partes do nome.
        local title = t:lower()
        local mob = q.mob:lower()
        -- tira prefixos "the ", "god's " etc para comparar
        local function strip(s) return (s:gsub("^the ", ""):gsub("[^%a%d]", "")) end
        title = strip(title); mob = strip(mob)
        if title == mob then return true end
        -- match parcial: title "bandits" contem "bandit"
        local stem = mob:sub(1, math.max(3, #mob - 2))
        return title:find(stem, 1, true) ~= nil
    end
    -- Pega a ultima quest cujo LevelReq <= lvl (mesma logica do jogo)
    local function pickQ(l)
        local best
        for _, q in ipairs(QUESTS) do if l >= q.minLevel then best = q end end
        return best
    end

    local function findTool(tip)
        local c = LP.Character; if not c then return nil end
        for _, x in ipairs(c:GetChildren()) do
            if x:IsA("Tool") and x.ToolTip == tip then return x end
        end
        for _, x in ipairs(LP.Backpack:GetChildren()) do
            if x:IsA("Tool") and x.ToolTip == tip then return x end
        end
        return nil
    end
    local function equip()
        local c = LP.Character; if not c then return nil end
        local t = findTool(BF.WeaponType)
        if not t then
            t = c:FindFirstChildOfClass("Tool")
            if not t then
                for _, x in ipairs(LP.Backpack:GetChildren()) do
                    if x:IsA("Tool") then t = x; break end
                end
            end
        end
        if t and t.Parent ~= c then
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then pcall(function() hum:EquipTool(t) end) end
            if t.Parent ~= c then t.Parent = c end
        end
        return t
    end

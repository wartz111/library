    local QuestPosCache = {}
    local function questPos(q)
        if QuestPosCache[q] then return QuestPosCache[q] end
        local pos = q.pos
        local ok, npc = pcall(function() return workspace:FindFirstChild(q.npc, true) end)
        if ok and npc then
            local ok2, cf = pcall(function() return npc:GetPivot() end)
            if ok2 and cf and cf.Position.Magnitude > 20 then pos = cf.Position end
        end
        QuestPosCache[q] = pos
        return pos
    end

    local function ensureQuest(q)
        local key = q.quest .. "#" .. q.index
        if hasQ() then
            if true then return true end -- ignorando locale match
            if BF.QuestCooldown > os.clock() then return false end
            abandonQ()
            BF.QuestCooldown = os.clock() + 1.5
            return false
        end

        local untilT = BF.BlockedUntil[key]
        if untilT then
            if os.clock() < untilT then return false end
            BF.BlockedUntil[key] = nil
        end
        
        if BF.QuestCooldown > os.clock() then return false end
        local h = getHRP(); if not h then return false end

        local qp = questPos(q)
        if (h.Position - qp).Magnitude > 15 then
            notify("Auto Farm", "A ir ate "..q.npc)
            local dest = qp + Vector3.new(0, 5, 0)
            goTo(dest, 90)
            task.wait(0.15)
            h = getHRP()
            if not h or (h.Position - qp).Magnitude > 25 then
                BF.QuestCooldown = os.clock() + 0.3
                return false
            end
        end

        local okQ, res = sendQ(q.quest, q.index)
        BF.LastQuestRes = tostring(okQ) .. " / " .. tostring(res)
        task.wait(0.6)
        BF.QuestCooldown = os.clock() + 0.8

        if okQ and res == 0 then
            for _ = 1, 20 do
                if hasQ() then return true end
                task.wait(0.25)
            end
            BF.BlockedUntil[key] = os.clock() + 3
            return false
        end

        if okQ and type(res) == "number" and res > 2 then
            q.minLevel = res 
            return false
        end

        BF.BlockedUntil[key] = os.clock() + 3 
        return false
    end

    local function bringNearby(mobName, center)

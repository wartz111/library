    -- entrada real da quest em ReplicatedStorage.Quests (Name da UI + Task)
    local QuestData
    local function getQuestEntry(q)
        if QuestData == nil then
            QuestData = false
            pcall(function()
                local mod = game:GetService("ReplicatedStorage"):FindFirstChild("Quests")
                if mod then QuestData = require(mod) end
            end)
        end
        local t = QuestData and QuestData[q.quest]
        return t and t[q.index]
    end

    -- compara o titulo da UI com os nomes da quest (nome do mob, Name da UI e Task)
    local function questMatches(q)
        local t = getQT()
        if not t or t == "" then return true end
        local function strip(s) return (s:lower():gsub("^the ", ""):gsub("[^%a%d]", "")) end
        local title = strip(t)
        local names = { q.mob }
        local e = getQuestEntry(q)
        if e then
            if e.Name then table.insert(names, tostring(e.Name)) end
            if e.ShortName then table.insert(names, tostring(e.ShortName)) end
            for mob in pairs(e.Task or {}) do table.insert(names, tostring(mob)) end
        end
        for _, nm in ipairs(names) do
            local st = strip(nm)
            st = st:sub(1, math.max(3, #st - 2))
            if title:find(st, 1, true) then return true end
        end
        return false
    end


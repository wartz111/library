        table.clear(ChestConns)
        table.clear(ChestCache)
    end
    local function farmChests()
        if not BF.AutoChest then return end
        local h = getHRP(); if not h then return end
        local best, bd
        for o in pairs(ChestCache) do
            if o.Parent then
                local d = (o.Position - h.Position).Magnitude
                if not bd or d < bd then best, bd = o, d end
            else
                ChestCache[o] = nil
            end
        end
        if best then
            tp(best.Position)
            ChestCache[best] = nil
            task.wait(0.4)
        end
    end


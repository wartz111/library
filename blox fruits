                if reach(mob) then fight(mob) end
                return true
            end
            local h = getHRP()
            if h and (h.Position - SHIP_POS).Magnitude > 60 then
                goTo(SHIP_POS + Vector3.new(0, 10, 0), 120)
            else
                task.wait(2)
            end
            return true
        end

        -- Auto Factory Raid (boss Core, so existe com a fabrica ativa)
        local function modeFactory()
            if Sea ~= 2 then return false end
            local mob = findEnemyLike({ "core" }, true)
            if not mob then return false end
            if reach(mob) then fight(mob) end
            return true
        end

        -- Elite Hunter (Diablo / Urban / Deandre)
        local ELITE = { "diablo", "urban", "deandre" }
        local nextElite = 0
        local function modeElite()
            if Sea ~= 3 then eliteStatus = "So no Terceiro Mar"; return false end
            local cf = getCommF(); if not cf then return false end
            pcall(function()
                local p = cf:InvokeServer("EliteHunter", "Progress")
                if type(p) == "number" then eliteProgress = p end
            end)
            local mob = findEnemyLike(ELITE)
            local tried = false
            if not mob and os.clock() >= nextElite then
                tried = true
                nextElite = os.clock() + 8
                pcall(function() cf:InvokeServer("EliteHunter") end)
                task.wait(1.5)
                mob = findEnemyLike(ELITE)
            end
            if mob then
                eliteStatus = "Found: " .. mob.Name
                if reach(mob) then fight(mob) end
                return true
            end
            eliteStatus = "Not Found"
            if tried and BF.EliteHop then serverHop("random") end
            return false
        end

        -- Rip Indra (so ataca se ja estiver spawnado)
        local function modeIndra()
            local mob = findEnemyLike({ "rip_indra", "rip indra" })
            if not mob then return false end
            if reach(mob) then fight(mob) end
            return true
        end

        -- Cake Prince (Terceiro Mar)
        local CAKE_MOBS = { "cookie crafter", "cake guard", "baking staff", "head baker" }
        local nextSpawn = 0
        local function cakeQuestFor(mobName)
            local best
            local l = getLvl() or 0
            for _, q in ipairs(QUESTS) do
                if q.sea == 3 and q.mob:lower() == mobName:lower() and l >= q.minLevel then best = q end
            end
            return best
        end
        local function modeCake()
            if Sea ~= 3 then return false end
            local prince = findEnemyLike({ "cake prince" })
            if not prince and BF.CakeSpawn and os.clock() >= nextSpawn then
                nextSpawn = os.clock() + 10
                local cf = getCommF()
                if cf then pcall(function() cf:InvokeServer("CakePrinceSpawner") end) end
                task.wait(1)
                prince = findEnemyLike({ "cake prince" })
            end
            if prince then
                if reach(prince) then fight(prince) end
                return true
            end
            local mob = findEnemyLike(CAKE_MOBS)
            if mob then
                local q
                if BF.CakeQuest then q = cakeQuestFor(mob.Name:match("^(.-)%s*%[") or mob.Name) end
                if q and not ensureQuest(q) then return true end
                if reach(mob) then fight(mob, q) end
                return true
            end
            for _, q in ipairs(QUESTS) do
                if q.sea == 3 and q.mob:lower() == CAKE_MOBS[1] then
                    goTo(questPos(q) + Vector3.new(0, 5, 0), 60)
                    return true
                end
            end
            return false
        end

        -- Berry (melhor esforco: usa a tag BerryBush; sem a tag o modo nao faz nada)
        local berryDone = {}
        local function modeBerry()
            local bushes = CollectionService:GetTagged("BerryBush")
            local h = getHRP()
            if not h then return false end
            local best, bd, bp
            for _, b in ipairs(bushes) do
                if not berryDone[b] or os.clock() > berryDone[b] then
                    local ok, p = pcall(function() return b:GetPivot().Position end)
                    if ok then
                        local d = (h.Position - p).Magnitude
                        if not bd or d < bd then best, bd, bp = b, d, p end
                    end
                end
            end
            if not best then
                if BF.BerryHop and #bushes > 0 then serverHop("random") end
                return false
            end
            goTo(bp + Vector3.new(0, 4, 0), 120)
            task.wait(0.4)
            for _, d in ipairs(best:GetDescendants()) do
                if d:IsA("ProximityPrompt") then pcall(fireproximityprompt, d) end
                if d:IsA("ClickDetector") then pcall(fireclickdetector, d) end
            end
            berryDone[best] = os.clock() + 120
            return true
        end

        local MODE_ORDER = { "elite", "indra", "cake", "factory", "ecto", "kill", "island", "nearest", "berry" }
        local MODE_FN = {
            elite = modeElite, indra = modeIndra, cake = modeCake, factory = modeFactory, ecto = modeEcto,
            kill = modeKill, island = modeIsland, nearest = modeNearest, berry = modeBerry,
        }

        local function modeTick()
            if not getHRP() then return end
            if safeRetreat() then return end
            masteryCheck()
            for _, name in ipairs(MODE_ORDER) do
                if BF.Modes[name] then
                    local ok, acted = pcall(MODE_FN[name])
                    if not ok then warn("modo " .. name .. ":", acted); FlyFarmMoving = false end
                    if ok and acted then return end
                end
            end
            task.wait(0.5)
        end

        function Modes.set(name, v)
            BF.Modes[name] = v and true or nil
            if v then
                spawnOnce("modes", function()
                    while anyMode() do
                        modeTick()
                        task.wait(0.15)
                    end
                end)
            end
        end
        function Modes.info() return kills, eliteProgress, eliteStatus end
    end


    local function resolveTarget()
        if BF.BossMob then return BF.BossMob, nil end
        if BF.FreeMob then return BF.FreeMob, nil end
        local l = getLvl(); if not l then return nil end
        local q = BF.SelectedQuest or pickQ(l)
        if not q then return nil end
        return q.mob, q
    end

    -- garante a quest certa ativa. true = pode atacar
    local function ensureQuest(q)
        local key = q.quest .. "#" .. q.index
        if hasQ() then
            if questMatches(q) then return true end
            if BF.QuestCooldown > os.clock() then return false end
            abandonQ()
            BF.QuestCooldown = os.clock() + 1.5
            return false
        end
        -- recusada pelo servidor: farma sem quest e volta ao NPC depois de um tempo
        local needLvl = BF.BlockedLvl[key]
        if needLvl then
            if (getLvl() or 0) >= needLvl then BF.BlockedLvl[key] = nil else return "noquest" end
        end
        local untilT = BF.BlockedUntil[key]
        if untilT then
            if os.clock() < untilT then return "noquest" end
            BF.BlockedUntil[key] = nil
        end
        if BF.QuestCooldown > os.clock() then return false end
        local h = getHRP(); if not h then return false end

        local qp = questPos(q)
        if (h.Position - qp).Magnitude > 15 then
            notify("Auto Farm", "Indo ate "..q.npc)
            local dest = qp + Vector3.new(0, 5, 0)
            goTo(dest, travelTimeout(h.Position, dest, 90))
            task.wait(0.15)
            h = getHRP()
            if not h or (h.Position - qp).Magnitude > 25 then
                BF.QuestCooldown = os.clock() + 0.3
                return false
            end
        end

        -- StartQuest devolve: 0 = aceita | 1 = erro | 2 = ja concluida | N>2 = nivel exigido
        local okQ, res = sendQ(q.quest, q.index)
        BF.LastQuestRes = tostring(okQ) .. " / " .. tostring(res)
        task.wait(0.6)
        BF.QuestCooldown = os.clock() + 0.8

        if okQ and res == 0 then
            for _ = 1, 6 do
                if hasQ() then break end
                task.wait(0.25)
            end
            if hasQ() then return true end
            -- servidor aceitou mas a UI nao mostrou: bate nos mobs assim mesmo
            BF.BlockedUntil[key] = os.clock() + 30
            return "noquest"
        end
        if okQ and res == 2 then
            BF.BlockedUntil[key] = os.clock() + 300   -- tenta de novo em 5 min
            notify("Auto Farm", "Quest ja concluida: farmando sem quest")
            return "noquest"
        end
        if okQ and type(res) == "number" and res > 2 then
            BF.BlockedLvl[key] = res
            notify("Auto Farm", "Quest pede nivel " .. res .. ": farmando sem quest")
            return "noquest"
        end

        -- codigo 1 ou resposta inesperada: nao deu, vai direto aos mobs
        BF.BlockedUntil[key] = os.clock() + 90        -- volta ao NPC em 90 s
        notify("Auto Farm", "Quest nao aceita (codigo " .. tostring(res) .. "): indo direto aos mobs")
        return "noquest"
    end

    local function bringNearby(mobName, center)
        for _, m in ipairs(getMobs(mobName)) do
            local mh = getRoot(m)
            if mh and (mh.Position - center).Magnitude < 60 then
                pcall(function()
                    mh.CFrame = CFrame.new(center + Vector3.new(0, -2, 0))
                    mh.AssemblyLinearVelocity = Vector3.zero
                end)
            end
        end
    end

    -- fica acima do mob, olhando para ele, batendo ate morrer
    local function engage(mob, q)
        local ch, h = GetChar(LP)
        if not ch or not h then return end
        FlyFarmMoving = true
        pcall(function()
            local t0 = os.clock()
            local nextAtk = 0
            while BF.Enabled and os.clock() - t0 < 12 do
                local mh = getRoot(mob)
                local mhum = mob:FindFirstChildOfClass("Humanoid")
                if not mob.Parent or not mh or not mhum or mhum.Health <= 0 then break end
                local hrp = getHRP()
                if not hrp or h.Health <= 0 then break end
                if q and not hasQ() then break end

                if BF.SafeMode and h.MaxHealth > 0 and h.Health / h.MaxHealth < BF.SafeHP / 100 then
                    safeRetreat()
                    break
                end

                local pos = mh.Position + Vector3.new(0, BF.Height, 2)
                hrp.CFrame = CFrame.lookAt(pos, mh.Position)
                hrp.AssemblyLinearVelocity = Vector3.zero
                hrp.AssemblyAngularVelocity = Vector3.zero
                if BF.BringMobs then bringNearby(mob.Name:match("^(.-)%s*%[") or mob.Name, mh.Position) end

                if os.clock() >= nextAtk then
                    atk(equip())
                    nextAtk = os.clock() + (BF.FastAttack and 0.08 or 0.2)
                end
                task.wait(0.03)
            end
        end)
        FlyFarmMoving = false
    end

    local function huntMob(mobName, fallbackPos)
        local h = getHRP(); if not h then return end
        local mobs = getMobs(mobName)

        if #mobs == 0 then
            -- 1) inimigo vivo por perto (raio curto se ha spawns; amplo se nao ha)
            local radii = spawnsFor(mobName) and { 70 } or { 100, 200, 400, 800 }
            for _, r in ipairs(radii) do
                local near = nearestAnyEnemy(h.Position, r)
                if near then return near end
            end

            -- 2) spawn conhecido (do mais perto do NPC ao mais longe)
            local ref = fallbackPos or h.Position
            local sp, key = pickSpawn(mobName, ref)
            local dest

            if sp then
                dest = sp.pos + Vector3.new(0, 10, 0)
            elseif fallbackPos then
                -- 3) sem spawns: orbita em volta do NPC
                if not BF.OrbitStart or BF.OrbitStart == 0
                    or (BF.OrbitAnchor and (BF.OrbitAnchor - fallbackPos).Magnitude > 50) then
                    BF.OrbitStart = os.clock()
                    BF.OrbitAnchor = fallbackPos
                end
                local elapsed = os.clock() - BF.OrbitStart
                local angle = (elapsed * 0.9) % (math.pi * 2)
                local radius = 100 + ((elapsed * 5) % 150)
                dest = fallbackPos + Vector3.new(math.cos(angle) * radius, 5, math.sin(angle) * radius)
            end

            if dest then
                if (h.Position - dest).Magnitude > 25 then
                    notify("Auto Farm", "Procurando "..mobName)
                    goTo(dest, travelTimeout(h.Position, dest, 60))
                else
                    task.wait(0.8) -- espera respawn e vai ao proximo spawn
                    if key then SpawnIdx[key] = (SpawnIdx[key] or 0) + 1 end
                end
            end
            return
        end

        table.sort(mobs, function(a, b)
            local ah, bh = getRoot(a), getRoot(b)
            if not ah or not bh then return false end
            return (h.Position - ah.Position).Magnitude < (h.Position - bh.Position).Magnitude
        end)
        local mob = mobs[1]
        local mh = getRoot(mob)
        if not mh then return end

        BF.OrbitStart = 0
        BF.OrbitAnchor = nil

        if (h.Position - mh.Position).Magnitude > 20 then
            local dest = mh.Position + Vector3.new(0, BF.Height, 0)
            goTo(dest, travelTimeout(h.Position, dest, 60))
        end
        return mob
    end

    local function farmTick()
        if not BF.Enabled then return end
        if not getHRP() then return end
        local mobName, q = resolveTarget()
        if not mobName then return end

        local qpos = q and questPos(q)
        if q then
            local r = ensureQuest(q)
            if r == "noquest" then q = nil       -- quest nao ativa: bate nos mobs mesmo assim
            elseif not r then return end
        end

        -- ponto fixo (so quando nao ha mob vivo por perto)
        local spot = FARM_SPOTS[mobName:lower()]
        if spot then
            if spot.water then applyWater(true) end
            local hrp = getHRP()
            if hrp and #getMobs(mobName) == 0 and (hrp.Position - spot.pos).Magnitude > 150 then
                notify("Auto Farm", "Indo ao ponto de "..mobName)
                goTo(spot.pos + Vector3.new(0, 5, 0), 25)
                return
            end
        end

        local mob = huntMob(mobName, qpos)
        if mob then engage(mob, q) end
    end

    local function startFarm()
        if BF.FarmThread then return end
        startNoclip()
        BF.FarmThread = task.spawn(function()
            while BF.Enabled do
                local ok, err = pcall(farmTick)
                if not ok then warn("farmTick:", err); FlyFarmMoving = false end
                task.wait(0.15)
            end
            BF.FarmThread = nil
        end)
    end


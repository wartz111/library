    sRaid:AddDropdown({ Name = "Selecionar Chip", Options = { "Flame", "Ice", "Quake", "Light", "Dark", "String", "Rumble", "Magma", "Buddha", "Sand", "Dough" }, Default = BF.RaidChip, Flag = "RaidChip", Callback = function(v) setOpt("RaidChip", v or "Flame") end })
    sRaid:AddToggle({ Name = "Auto Completar Raid", Default = false, Flag = "AutoRaid", Callback = function(v)
        BF.AutoRaid = v
        if v then loopFlag("raid", "AutoRaid", farmRaid, 0.1) end
    end })

    local sSea = raidTab:AddSection("Sea Events (Mar 2 e 3)")
    sSea:AddDropdown({ Name = "Barco", Options = { "Dinghy", "Sloop", "Lantern", "Swan" }, Default = BF.BoatName, Flag = "BoatName", Callback = function(v) setOpt("BoatName", v or "Sloop") end })
    sSea:AddToggle({ Name = "Auto Caçar Monstros do Mar", Default = false, Flag = "SeaEvents", Callback = function(v)
        BF.SeaEvents = v
        if v then loopFlag("sea", "SeaEvents", farmSeaEvents, 0.1) end
    end })

    ------------------------------------------------------------------ STATUS + MANUTENCAO
    local lastStatus = ""
    local function updateStatus()
        local lvl = getLvl() or "?"
        local beli, frag = "?", "?"
        pcall(function() beli = LP.Data.Beli.Value; frag = LP.Data.Fragments.Value end)
        local q = hasQ() and (getQT() or "ativa") or "nenhuma"
        local txt = string.format("%s | Lv %s | Beli %s | Frag %s | Quest: %s | Farm: %s",
            getSeaName(), tostring(lvl), tostring(beli), tostring(frag), q, BF.Enabled and "ON" or "OFF")
        if txt ~= lastStatus then
            lastStatus = txt
            setLabel(statusLbl, txt)
        end
    end

    local alive = true
    task.spawn(function()
        while alive do
            pcall(function()
                if BF.AutoBuso then
                    local c = LP.Character
                    if c and not c:FindFirstChild("HasBuso") then
                        local cf = getCommF(); if cf then pcall(function() cf:InvokeServer("Buso") end) end
                    end
                end
            end)
            pcall(updateStatus)
            task.wait(1)
        end
    end)

    do
        -- Dungeon / Raiding
        local function hasChip()
            for _, c in ipairs({ LP.Backpack, LP.Character }) do
                if c and c:FindFirstChild("Special Microchip") then return true end
            end
            return false
        end
        local function buyChip()
            local cf = getCommF(); if not cf then return end
            pcall(function() cf:InvokeServer("RaidsNpc", "Select", BF.RaidChip) end)
        end
        local function chipLoop()
            if not hasChip() then buyChip() end
        end
        -- melhor esforco: usa os remotes getInventoryFruits / LoadFruit
        local function cheapFruit()
            local cf = getCommF(); if not cf then return end
            for _, c in ipairs({ LP.Backpack, LP.Character }) do
                if c then
                    for _, t in ipairs(c:GetChildren()) do
                        if t:IsA("Tool") and t.ToolTip == "Blox Fruit" then return end
                    end
                end
            end
            local ok, inv = pcall(function() return cf:InvokeServer("getInventoryFruits") end)
            if ok and type(inv) == "table" then
                for _, it in ipairs(inv) do
                    if type(it) == "table" and it.Name and (tonumber(it.Price) or 9e9) < 1000000 then
                        pcall(function() cf:InvokeServer("LoadFruit", it.Name) end)
                        task.wait(0.5)
                        break
                    end
                end
            end
        end

        local sDun = raidTab:AddSection("Dungeon Event / Raiding")
        sDun:AddButton({ Name = "Buy Dungeon Chip [Beli]", Callback = buyChip })
        sDun:AddToggle({ Name = "Auto Buy Chip [Beli]", Default = false, Flag = "AutoBuyChip", Callback = function(v)
            BF.AutoBuyChip = v
            if v then loopFlag("buychip", "AutoBuyChip", chipLoop, 5) end
        end })
        sDun:AddToggle({ Name = "Get Fruit In Inventory Below 1M", Default = false, Flag = "CheapFruit", Callback = function(v)
            BF.CheapFruit = v
            if v then loopFlag("cheapfruit", "CheapFruit", cheapFruit, 5) end
        end })

        -- Auto Travel
        local sAT = utilTab:AddSection("Travel - Auto")
        sAT:AddToggle({ Name = "Auto Travel (ilha selecionada)", Default = false, Flag = "AutoTravel", Callback = function(v)
            BF.AutoTravel = v
            if v then
                loopFlag("autotravel", "AutoTravel", function()
                    local h = getHRP()
                    local pos = ISLAND_POS[BF.TPIsland or ""]
                    if h and pos and (h.Position - pos).Magnitude > 50 then tpIsland() end
                end, 3)
            end
        end })

        -- Server - Function
        local jobInput = ""
        local sSrv = utilTab:AddSection("Server - Function")
        sSrv:AddButton({ Name = "Rejoin Server", Callback = function()
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LP) end)
        end })
        sSrv:AddButton({ Name = "Hop Server", Callback = function() task.spawn(serverHop, "random") end })
        sSrv:AddButton({ Name = "Hop to Lowest Players", Callback = function() task.spawn(serverHop, "fewest") end })
        sSrv:AddButton({ Name = "Hop to Lowest Pings Server", Callback = function() task.spawn(serverHop, "ping") end })
        local hasJobInput = addInput(sSrv, "Input Job Id", "JobIdInput", "cola o JobId aqui", function(v)
            jobInput = (tostring(v or ""):gsub("%s+", ""))
        end)
        if hasJobInput then
            sSrv:AddButton({ Name = "Join Job Id", Callback = function()
                if jobInput == "" then notify("Server", "Cola o JobId primeiro", "warn", 2); return end
                pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, jobInput, LP) end)
            end })
        else
            sSrv:AddLabel("Sem caixa de texto na UI: Job Id indisponivel")
        end

        -- atualiza os labels de Info e dos modos
        local t0 = os.clock()
        task.spawn(function()
            while alive do
                pcall(function()
                    local k, ep, es = Modes.info()
                    local lvl = getLvl() or "?"
                    local beli, frag = "?", "?"
                    pcall(function() beli = LP.Data.Beli.Value; frag = LP.Data.Fragments.Value end)
                    setLabel(infoLbls.elite, "Elite Progress : " .. tostring(ep))
                    setLabel(infoLbls.estatus, "Status: " .. tostring(es))
                    setLabel(infoLbls.killed, "Killed : " .. tostring(k))
                    setLabel(infoLbls.lvl, "Level: " .. tostring(lvl))
                    setLabel(infoLbls.money, "Beli: " .. tostring(beli) .. " | Fragmentos: " .. tostring(frag))
                    setLabel(infoLbls.players, "Jogadores: " .. #Players:GetPlayers())
                    setLabel(infoLbls.time, "Sessão: " .. math.floor(os.clock() - t0) .. "s")
                end)
                task.wait(1)
            end
        end)
    end

    local VU = game:GetService("VirtualUser")
    local afkConn = LP.Idled:Connect(function()
        if not BF.AntiAFK then return end
        pcall(function() VU:CaptureController(); VU:ClickButton2(Vector2.new()) end)
    end)

    return function()
        alive = false
        for _, k in ipairs({ "Enabled", "AutoChest", "AutoFruit", "AutoRaid", "SeaEvents", "KillAura", "AutoStats",
            "AutoStore", "FruitWebhook", "FruitESP", "PlayerESP", "HopLow", "HuntFruit", "AutoAwaken", "Mastery", "Teleporting" }) do
            BF[k] = false
        end
        chestCacheStop()
        fpsBoost(false)
        BF.Modes = {}
        BF.AutoTravel, BF.AutoBuyChip, BF.CheapFruit = false, false, false
        pcall(function() afkConn:Disconnect() end)
    end
end

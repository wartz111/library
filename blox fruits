        -- Fishing (FishReplicated.FishingRequest)
        function Modes.fishing()
            local fr = RS:FindFirstChild("FishReplicated")
            local req = fr and fr:FindFirstChild("FishingRequest")
            if not req then
                notify("Fishing", "FishReplicated nao encontrado neste servidor", "warn", 3)
                BF.AutoFishing = false
                return
            end
            local okW, getWater = pcall(function() return require(RS.Util.GetWaterHeightAtLocation) end)
            local okC, maxDist = pcall(function() return require(fr.FishingClient.Config).Rod.MaxLaunchDistance end)
            if not okW then getWater = function() return 0 end end
            if not okC then maxDist = 60 end
            while BF.AutoFishing do
                pcall(function()
                    local ch = LP.Character
                    local hrp = ch and ch:FindFirstChild("HumanoidRootPart")
                    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
                    local head = ch and ch:FindFirstChild("Head")
                    if not hrp or not hum or not head then return end
                    local tool = ch:FindFirstChildOfClass("Tool")
                    if BF.FishRod and (not tool or tool.Name ~= BF.FishRod) then
                        local rod = LP.Backpack:FindFirstChild(BF.FishRod)
                        if rod then hum:EquipTool(rod); tool = rod end
                    end
                    if not tool then return end
                    local water = getWater(hrp.Position)
                    local ignore = { ch }
                    for _, n in ipairs({ "Characters", "Enemies" }) do
                        local f = workspace:FindFirstChild(n)
                        if f then ignore[#ignore + 1] = f end
                    end
                    local rp = RaycastParams.new()
                    rp.FilterType = Enum.RaycastFilterType.Exclude
                    rp.FilterDescendantsInstances = ignore
                    local dir = hrp.CFrame.LookVector * maxDist
                    local r = workspace:Raycast(head.Position, dir, rp)
                    local hit = r and r.Position or (head.Position + dir)
                    hit = Vector3.new(hit.X, math.max(hit.Y, water), hit.Z)
                    local st, sv = tool:GetAttribute("State"), tool:GetAttribute("ServerState")
                    if st == "ReeledIn" or sv == "ReeledIn" then
                        req:InvokeServer("StartCasting")
                        task.wait()
                        req:InvokeServer("CastLineAtLocation", hit, 100, true)
                    elseif sv == "Biting" then
                        req:InvokeServer("Catching", true)
                        task.wait(0.1)
                        req:InvokeServer("Catch", 1)
                    end
                end)
                task.wait()
            end
        end
    end


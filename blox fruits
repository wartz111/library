    local function fruitRank(f)
        local n = f.Name:lower()
        for rank, list in ipairs(FRUIT_RARITY) do
            for _, k in ipairs(list) do
                local pat = "%f[%a]" .. k:gsub("%p", "%%%0") .. "%f[%A]"
                if n:find(pat) then return rank end
            end
        end
        return 0
    end


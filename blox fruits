    -- Auto Chest (tag _ChestTagged, com cache, Stop Items e Bypass)
    local CollectionService = game:GetService("CollectionService")
    local ChestCache, ChestConns = {}, {}
    local function heldItem(n)
        for _, c in ipairs({ LP.Backpack, LP.Character }) do
            if c and c:FindFirstChild(n) then return true end
        end
        return false
    end
    local function chestAdd(o) ChestCache[o] = true end
    local function chestCacheStart()
        if #ChestConns > 0 then return end
        for _, o in ipairs(CollectionService:GetTagged("_ChestTagged")) do chestAdd(o) end
        ChestConns[1] = CollectionService:GetInstanceAddedSignal("_ChestTagged"):Connect(chestAdd)
        ChestConns[2] = CollectionService:GetInstanceRemovedSignal("_ChestTagged"):Connect(function(o) ChestCache[o] = nil end)
    end
    local function chestCacheStop()
        for _, c in ipairs(ChestConns) do pcall(function() c:Disconnect() end) end
        table.clear(ChestConns)
        table.clear(ChestCache)
    end
    local function farmChests()
        if not BF.AutoChest then return end
        if BF.StopOnItems and (heldItem("Fist of Darkness") or heldItem("God's Chalice")) then return end
        local h = getHRP(); if not h then return end
        local best, bd, bpos
        for o in pairs(ChestCache) do
            if o.Parent and not o:GetAttribute("IsDisabled") then
                local ok, p = pcall(function() return o:GetPivot().Position end)
                if ok then
                    local d = (p - h.Position).Magnitude
                    if not bd or d < bd then best, bd, bpos = o, d, p end
                end
            else
                ChestCache[o] = nil
            end
        end
        if best then
            tp(bpos)
            ChestCache[best] = nil
            task.wait(0.4)
        end
    end

    -- Chest Bypass: teleporta direto para a Part do bau (Parts "Chest*" com TouchInterest)
    local function chestBypassLoop()
        local list = {}
        for _, o in ipairs(game:GetDescendants()) do
            if o.ClassName == "Part" and o.Name:find("Chest") then list[#list + 1] = o end
        end
        while BF.ChestBypass do
            local h = getHRP()
            local best, bd
            if h then
                for _, c in ipairs(list) do
                    if c.Parent and c:FindFirstChild("TouchInterest") then
                        local d = (c.Position - h.Position).Magnitude
                        if not bd or d < bd then best, bd = c, d end
                    end
                end
                if best then h.CFrame = best.CFrame end
            end
            task.wait(0.1)
        end
    end


    local function titleCase(s)
        return (s:gsub("(%a)([%w']*)", function(a, b) return a:upper() .. b end))
    end

    local function setLabel(lbl, txt)
        if not lbl then return end
        for _, m in ipairs({ "Set", "SetText", "SetValue", "Update" }) do
            local ok, f = pcall(function() return lbl[m] end)
            if ok and type(f) == "function" then
                if pcall(f, lbl, txt) then return end
            end
        end
        pcall(function() lbl.Text = txt end)
    end

    local function addInput(section, name, flag, placeholder, cb)
        for _, m in ipairs({ "AddTextbox", "AddTextBox", "AddInput" }) do
            local ok, f = pcall(function() return section[m] end)
            if ok and type(f) == "function" then
                if pcall(f, section, { Name = name, Default = "", Placeholder = placeholder, Flag = flag, Callback = cb }) then
                    return true
                end
            end
        end
        return false
    end


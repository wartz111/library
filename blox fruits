    local function engage(mob, q)
        local ch, h = GetChar(LP)
        if not ch or not h then return end
        FlyFarmMoving = true
        pcall(function()
            local t0 = os.clock()
            local nextAtk = 0
            while farmOn() and os.clock() - t0 < 40 do
                local mh = getRoot(mob)
                local mhum = mob:FindFirstChildOfClass("Humanoid")
                if not mob.Parent or not mh or not mhum or mhum.Health <= 0 then break end
                local hrp = getHRP()
                if not hrp or h.Health <= 0 then break end
                if q and not hasQ() then break end
                if safeRetreat() then break end

                local pos = mh.Position + Vector3.new(0, BF.Height, 2)
                hrp.CFrame = CFrame.lookAt(pos, mh.Position)
                
                if BF.BringMobs then bringNearby(mob.Name:match("^(.-)%s*%[") or mob.Name, mh.Position) end

                useSkills(BF.Mastery)

                if os.clock() >= nextAtk then
                    atk(equip(currentTip()))
                    nextAtk = os.clock() + (BF.FastAttack and 0.08 or 0.2)
                end
                task.wait(0.03)
            end
        end)
        FlyFarmMoving = false
    end

    local function getMobs(mobName)
        local exact = {}
        local enemies = workspace:FindFirstChild("Enemies")
        if not enemies or not mobName then return exact end
        for _, m in ipairs(enemies:GetChildren()) do
            local hum = m:FindFirstChildOfClass("Humanoid")
            local root = getRoot(m)
            if hum and hum.Health > 0 and root then
                if nameMatches(m.Name, mobName) then
                    table.insert(exact, m)
                end
            end
        end
        return exact
    end

    local function huntMob(mobName, fallbackPos)
        local h = getHRP(); if not h then return end
        local mobs = getMobs(mobName)

        if #mobs == 0 then
            local dest = fallbackPos and (fallbackPos + Vector3.new(0, 5, 0)) or h.Position
            if (h.Position - dest).Magnitude > 25 then
                notify("Auto Farm", "Procurando "..mobName)
                goTo(dest, 60)
            else
                task.wait(3)
            end
            return nil
        end

        table.sort(mobs, function(a, b)
            local ah, bh = getRoot(a), getRoot(b)
            if not ah or not bh then return false end
            return (h.Position - ah.Position).Magnitude < (h.Position - bh.Position).Magnitude
        end)
        
        local mob = mobs[1]
        local mh = getRoot(mob)
        if not mh then return end

        if (h.Position - mh.Position).Magnitude > 20 then
            local dest = mh.Position + Vector3.new(0, BF.Height, 0)
            goTo(dest, 60)
        end
        return mob
    end

    local function farmTick()
        if not BF.Enabled then return end
        if anyMode() then task.wait(0.5); return end -- os modos extra tem prioridade sobre o farm de level
        if not getHRP() then return end
        if safeRetreat() then return end
        masteryCheck()

        local mobName, q
        if BF.BossMob then
            mobName = BF.BossMob
            if BF.BossQuest then q = bossQuestOf(BF.BossMob) end
        elseif BF.FreeMob then
            mobName = BF.FreeMob
        else
            local l = getLvl(); if not l then return end
            q = BF.SelectedQuest or pickQ(l)
            if not q then return end
            mobName = q.mob
        end

        local qpos = q and questPos(q)
        if q then
            local r = ensureQuest(q)
            if not r then return end -- Aguarda conseguir a missao antes de atacar
        end

        local mob = huntMob(mobName, qpos)
        if mob then engage(mob, q) end
    end


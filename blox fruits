    local hopping = false
    local function serverHop(mode)
        if hopping then return end
        hopping = true
        task.delay(20, function() hopping = false end)
        local ok, err = pcall(function()
            local cursor, found = "", {}
            for _ = 1, 3 do
                local url = string.format(
                    "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100%s",
                    game.PlaceId, cursor ~= "" and ("&cursor=" .. cursor) or "")
                local data = HttpService:JSONDecode(httpGet(url))
                for _, s in ipairs(data.data or {}) do
                    if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing <= s.maxPlayers - 2 then
                        found[#found + 1] = s
                    end
                end
                cursor = data.nextPageCursor
                if not cursor then break end
            end
            if #found == 0 then error("nenhum servidor disponivel") end
            local pick
            if mode == "most" then
                table.sort(found, function(a, b) return a.playing > b.playing end)
                pick = found[1]
            elseif mode == "fewest" then
                table.sort(found, function(a, b) return a.playing < b.playing end)
                pick = found[1]
            elseif mode == "ping" then
                table.sort(found, function(a, b) return (a.ping or 9e9) < (b.ping or 9e9) end)
                pick = found[1]
            else
                pick = found[math.random(#found)]
            end
            notify("Server Hop", "A trocar de servidor...", "info", 3)
            TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LP)
        end)
        if not ok then
            warn("serverHop:", err)
            notify("Server Hop", "Falhou: " .. tostring(err), "warn", 3)
            hopping = false
        end
    end


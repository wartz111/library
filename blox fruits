    -- FPS Boost (reversivel)
    local FPS = { orig = {}, conn = nil, quality = nil, shadows = nil }
    local function fpsApply(o)
        if FPS.orig[o] then return end
        pcall(function()
            if LP.Character and o:IsDescendantOf(LP.Character) then return end
            if o:IsA("ParticleEmitter") or o:IsA("Trail") or o:IsA("Smoke") or o:IsA("Fire")
                or o:IsA("Sparkles") or o:IsA("PostEffect") then
                FPS.orig[o] = { "Enabled", o.Enabled }
                o.Enabled = false
            elseif o:IsA("Decal") or o:IsA("Texture") then
                FPS.orig[o] = { "Transparency", o.Transparency }
                o.Transparency = 1
            elseif o:IsA("BasePart") then
                FPS.orig[o] = { "Material", o.Material }
                o.Material = Enum.Material.SmoothPlastic
            end
        end)
    end
    local function fpsBoost(on)
        if on then
            if FPS.conn then return end
            FPS.shadows = Lighting.GlobalShadows
            pcall(function() Lighting.GlobalShadows = false end)
            pcall(function()
                FPS.quality = settings().Rendering.QualityLevel
                settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            end)
            FPS.conn = workspace.DescendantAdded:Connect(fpsApply)
            task.spawn(function()
                local n = 0
                for _, o in ipairs(workspace:GetDescendants()) do
                    if not FPS.conn then return end
                    fpsApply(o)
                    n = n + 1
                    if n % 400 == 0 then task.wait() end
                end
                for _, o in ipairs(Lighting:GetDescendants()) do fpsApply(o) end
            end)
        else
            if FPS.conn then FPS.conn:Disconnect(); FPS.conn = nil end
            for o, d in pairs(FPS.orig) do pcall(function() o[d[1]] = d[2] end) end
            FPS.orig = {}
            pcall(function() if FPS.shadows ~= nil then Lighting.GlobalShadows = FPS.shadows end end)
            pcall(function() if FPS.quality then settings().Rendering.QualityLevel = FPS.quality end end)
        end
    end

    -- ESP generico (players e frutas)
    local function espLoop(key, color, collect)
        if not Drawing then
            notify("ESP", "Drawing API indisponivel no teu executor", "warn", 3)
            return
        end
        local objs = {}
        while BF[key] do
            local cam = workspace.CurrentCamera
            local me = getHRP()
            local seen = {}
            local ok, list = pcall(collect)
            for _, it in ipairs(ok and list or {}) do
                seen[it.key] = true
                local t = objs[it.key]
                if not t then
                    t = Drawing.new("Text")
                    t.Size = 18; t.Color = color; t.Center = true; t.Outline = true
                    objs[it.key] = t
                end
                local pos, on = cam:WorldToViewportPoint(it.part.Position)
                if on and pos.Z > 0 then
                    local d = me and (me.Position - it.part.Position).Magnitude or 0
                    t.Position = Vector2.new(pos.X, pos.Y - 20)
                    t.Text = string.format("%s [%.0fm]", it.name, d)
                    t.Visible = true
                else
                    t.Visible = false
                end
            end
            for k, t in pairs(objs) do
                if not seen[k] then pcall(function() t:Remove() end); objs[k] = nil end
            end
            task.wait(0.05)
        end
        for _, t in pairs(objs) do pcall(function() t:Remove() end) end
    end


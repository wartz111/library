            if on then L.FogEnd = 9e9 end
        end)
        if not on then return end
        task.spawn(function()
            local n = 0
            for _, v in ipairs(workspace:GetDescendants()) do
                if v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke")
                    or v:IsA("Fire") or v:IsA("Sparkles") then
                    pcall(function() v.Enabled = false end)
                end
                n += 1
                if n % 400 == 0 then task.wait() end
            end
        end)
    end

    -- Modo Seguro: com vida baixa sobe 120 studs e espera regenerar
    local function safeRetreat()
        local ch, h, hrp = GetChar(LP)
        if not hrp or not h then return end
        notify("Modo Seguro", "Vida baixa: recuando")
        local up = hrp.Position + Vector3.new(0, 120, 0)
        local t0 = os.clock()
        while BF.Enabled and BF.SafeMode and h.Parent and h.Health > 0 and os.clock() - t0 < 25 do
            hrp = getHRP(); if not hrp then break end
            hrp.CFrame = CFrame.new(up)
            hrp.AssemblyLinearVelocity = Vector3.zero
            if h.Health / math.max(h.MaxHealth, 1) >= 0.8 then break end
            task.wait(0.1)
        end
    end

    -- WaterWalking: atributo do proprio jogo
    local function applyWater(on)
        local c = LP.Character
        local found = false
        for _, inst in ipairs({ c, LP }) do
            if inst then
                local ok, v = pcall(function() return inst:GetAttribute("WaterWalking") end)
                if ok and v ~= nil then
                    found = true
                    if v ~= on then pcall(function() inst:SetAttribute("WaterWalking", on) end) end
                end
            end
        end
        if not found and c then pcall(function() c:SetAttribute("WaterWalking", on) end) end
    end

    -- NOCLIP continuo (o jogo reativa a colisao todo frame)
    local NoclipSaved = {}
    local noclipConn
    local function startNoclip()
        if noclipConn then return end
        noclipConn = RunService.Stepped:Connect(function()
            if not BF.Enabled then return end
            local c = LP.Character; if not c then return end
            for _, p in ipairs(c:GetDescendants()) do
                if p:IsA("BasePart") then
                    if NoclipSaved[p] == nil then NoclipSaved[p] = p.CanCollide end
                    p.CanCollide = false
                end
            end
        end)
    end
    local function stopNoclip()
        if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
        if not CFG.Noclip then
            for p, v in pairs(NoclipSaved) do
                if p and p.Parent then pcall(function() p.CanCollide = v end) end
            end
        end
        table.clear(NoclipSaved)
    end

    --================================================--
    -- SPAWNS (_WorldOrigin.EnemySpawns + ReplicatedStorage)
    --================================================--
    local SpawnsByMob = {}   -- ["bandit"] = { {pos, level, boss} }
    local SpawnNames = {}
    local JUNK = { part = true, humanoidrootpart = true, model = true, spawn = true }

    local function addSpawn(mob, lv, boss, pos)
        local k = mob:lower()
        SpawnsByMob[k] = SpawnsByMob[k] or {}
        for _, sp in ipairs(SpawnsByMob[k]) do
            if (sp.pos - pos).Magnitude < 5 then return end
        end
        SpawnNames[k] = SpawnNames[k] or mob
        table.insert(SpawnsByMob[k], { pos = pos, level = lv or 0, boss = boss })
    end
    local function pivotPos(inst)
        local ok, cf = pcall(function() return inst:GetPivot() end)
        return ok and cf and cf.Position or nil
    end

    local function scanSpawns()
        table.clear(SpawnsByMob); table.clear(SpawnNames)

        local origin = workspace:FindFirstChild("_WorldOrigin")
        local folder = origin and origin:FindFirstChild("EnemySpawns")
        if folder then
            for _, sp in ipairs(folder:GetChildren()) do
                local mob, lv, boss = parseName(sp.Name)
                local pos = mob and pivotPos(sp)
                if pos then addSpawn(mob, lv, boss, pos) end
            end
        end

        local rs = game:GetService("ReplicatedStorage"):FindFirstChild("FortBuilderReplicatedSpawnPositionsFolder")
        if rs then
            for _, sp in ipairs(rs:GetChildren()) do
                local name = sp.Name
                if not tonumber(name) and not JUNK[name:lower()] then
                    local mob = parseName(name) or name
                    local pos = pivotPos(sp)
                    if pos then addSpawn(mob, nil, BOSS_NAMES[mob:lower()] == true, pos) end
                end
            end
        end
        return next(SpawnsByMob) ~= nil
    end

    -- spawns do mob (ou de um alias)
    local function spawnsFor(mobName)
        local l = SpawnsByMob[mobName:lower()]
        if l and #l > 0 then return l end
        for _, a in ipairs(ALIASES[mobName:lower()] or {}) do
            local l2 = SpawnsByMob[a]
            if l2 and #l2 > 0 then return l2 end
        end
        return nil
    end

    local SpawnIdx = {}
    local function pickSpawn(mobName, ref)
        local list = spawnsFor(mobName)
        if not list then return nil end
        local sorted = {}
        for _, sp in ipairs(list) do table.insert(sorted, sp) end
        table.sort(sorted, function(x, y) return (x.pos - ref).Magnitude < (y.pos - ref).Magnitude end)
        local k = mobName:lower()
        local i = ((SpawnIdx[k] or 0) % #sorted) + 1
        return sorted[i], k
    end

    local function buildMobLists()
        local normals, bosses = {}, {}
        for k, list in pairs(SpawnsByMob) do
            local entry = { name = SpawnNames[k], level = list[1].level }
            if list[1].boss then table.insert(bosses, entry) else table.insert(normals, entry) end
        end
        local function cmp(a, b)
            if a.level ~= b.level then return a.level < b.level end
            return a.name < b.name
        end
        table.sort(normals, cmp); table.sort(bosses, cmp)
        local nOpts, bOpts, nMap, bMap = { "Nenhum" }, { "Nenhum" }, {}, {}
        for _, e in ipairs(normals) do
            local lbl = e.name..(e.level > 0 and (" [Lv. "..e.level.."]") or "")
            table.insert(nOpts, lbl); nMap[lbl] = e.name
        end
        for _, e in ipairs(bosses) do
            local lbl = e.name..(e.level > 0 and (" [Lv. "..e.level.."]") or "")
            table.insert(bOpts, lbl); bMap[lbl] = e.name
        end
        return nOpts, bOpts, nMap, bMap
    end


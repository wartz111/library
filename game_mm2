--!nocheck
--================================================--
-- PREMIUM HUB v10.9 - MM2 MODULE (AUTO GUN & SCANNER)
--================================================--
return function(ctx)
    local Library=ctx.Library; local CFG=ctx.CFG; local Window=ctx.Window
    local LP=ctx.LP; local GetChar=ctx.GetChar
    local IS_MM2=ctx.L.IS_MM2

    if not IS_MM2 then return end

    --================================================--
    -- UI
    --================================================--
    local mm2Tab = Window:AddTab("Murder Mystery 2", "🔪")
    local sMM2St = mm2Tab:AddSection("Status")
    local mm2St = sMM2St:AddLabel("Verificando...")
    task.spawn(function() task.wait(2); mm2St:Set("[OK] MM2 detectado") end)

    local sMM2E = mm2Tab:AddSection("ESP")
    sMM2E:AddToggle({ Name="ESP Murderer", Default=false, Flag="MM2_ESP_Murderer", Callback=function(v) CFG.MM2_ESP_Murderer=v end })
    sMM2E:AddToggle({ Name="ESP Sheriff", Default=false, Flag="MM2_ESP_Sheriff", Callback=function(v) CFG.MM2_ESP_Sheriff=v end })
    sMM2E:AddToggle({ Name="ESP Innocent", Default=false, Flag="MM2_ESP_Innocent", Callback=function(v) CFG.MM2_ESP_Innocent=v end })

    -- SEÇÃO: AUTO COLETAR (MOEDAS E ARMAS)
    local sMM2C = mm2Tab:AddSection("Auto Coletar")
    sMM2C:AddToggle({
        Name = "Coletar Moedas Instantâneo",
        Default = false,
        Flag = "MM2_AutoCoins",
        Callback = function(v) CFG.MM2_AutoCoins = v end
    })
    sMM2C:AddToggle({
        Name = "Auto Pegar Arma (GunDrop)",
        Default = false,
        Flag = "MM2_AutoGun",
        Callback = function(v) CFG.MM2_AutoGun = v end
    })
    sMM2C:AddButton({
        Name = "Escanear Armas no Mapa (Log)",
        Callback = function()
            local names = {}
            for _, obj in ipairs(workspace:GetDescendants()) do
                local n = string.lower(obj.Name)
                if n:find("gun") or n:find("revolver") or n:find("pistol") or n == "gundrop" then
                    table.insert(names, obj.Name)
                end
            end
            print("--- ARMAS ENCONTRADAS ---")
            for _, name in ipairs(names) do
                print(name)
            end
            print("Total: " .. #names)
        end
    })

    local sMM2M = mm2Tab:AddSection("Speed e Jump")
    sMM2M:AddSlider({ Name="Velocidade", Min=16, Max=100, Default=16, Step=1, Flag="MM2_Speed", Callback=function(v) CFG.MM2_Speed=v end })
    sMM2M:AddSlider({ Name="Pulo", Min=50, Max=200, Default=50, Step=5, Flag="MM2_Jump", Callback=function(v) CFG.MM2_Jump=v end })

    --================================================--
    -- FUNÇÕES AUXILIARES
    --================================================--

    -- Encontra o CoinContainer do mapa ativo
    local function getCoinContainer()
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") or obj:IsA("Folder") then
                local container = obj:FindFirstChild("CoinContainer")
                if container then
                    return container
                end
            end
        end
        return nil
    end

    -- Coleta todas as moedas usando firetouchinterest
    local function collectAllCoins(hrp)
        local container = getCoinContainer()
        if not container then return end
        for _, coin in ipairs(container:GetChildren()) do
            if coin:IsA("BasePart") then
                pcall(function()
                    firetouchinterest(hrp, coin, 0)
                    firetouchinterest(hrp, coin, 1)
                end)
            end
        end
    end

    -- Encontra a arma caída (GunDrop ou similar)
    local function getDroppedGun()
        -- Procura direta pelo GunDrop (comum no MM2)
        local gun = workspace:FindFirstChild("GunDrop")
        if gun and gun:IsA("BasePart") then
            return gun
        end
        -- Fallback: procura por qualquer parte com nome relacionado
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") then
                local n = string.lower(obj.Name)
                if n:find("gun") or n:find("revolver") or n:find("pistol") then
                    return obj
                end
            end
        end
        return nil
    end

    -- Coleta a arma (teleporte ou touch)
    local function grabGun(hrp)
        local gun = getDroppedGun()
        if not gun then return end
        -- Opção 1: Teleporte (mais garantido)
        -- hrp.CFrame = gun.CFrame
        -- Opção 2: Firetouchinterest (mais discreto)
        pcall(function()
            firetouchinterest(hrp, gun, 0)
            firetouchinterest(hrp, gun, 1)
        end)
    end

    --================================================--
    -- LOOP PRINCIPAL
    --================================================--
    task.spawn(function()
        while task.wait(0.2) do
            local char, hrp = GetChar(LP)
            if char and hrp then
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then
                    if CFG.MM2_Speed ~= 16 then hum.WalkSpeed = CFG.MM2_Speed end
                    if CFG.MM2_Jump ~= 50 then hum.JumpPower = CFG.MM2_Jump end
                end

                if CFG.MM2_AutoCoins then
                    collectAllCoins(hrp)
                end

                if CFG.MM2_AutoGun then
                    grabGun(hrp)
                end
            end
        end
    end)
end

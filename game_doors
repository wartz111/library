-- Módulo DOORS PRO - Premium Hub v10.9
return function(ctx)
    local Library = ctx.Library
    local Window = ctx.Window
    local Workspace = game:GetService("Workspace")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")

    -- ==========================================
    -- 1. CRIAÇÃO DA INTERFACE (Sem Duplicações)
    -- ==========================================
    local doorsTab = ctx.DoorsTab or Window:AddTab("Doors", "🚪")
    
    local sInfo = doorsTab:AddSection("Informações & Estado")
    local sESP = doorsTab:AddSection("Funcionalidades ESP")

    -- Obter modo atual de forma segura
    local currentMode = "Desconhecido"
    pcall(function()
        local floor = ReplicatedStorage:WaitForChild("GameData", 3):WaitForChild("Floor", 3)
        if floor then currentMode = floor.Value end
    end)

    sInfo:AddButton({
        Name = "Modo Atual: " .. tostring(currentMode),
        Callback = function()
            Library:Notify({Title = "DOORS", Message = "Modo: " .. tostring(currentMode), Type = "info"})
        end
    })

    -- ==========================================
    -- 2. LÓGICA DOS TOGGLES E VARIÁVEIS
    -- ==========================================
    local ESP_Settings = { RoomExit = true, Soda = true, Entities = true }

    sESP:AddToggle({
        Name = "ESP Saídas (RoomExit)",
        Default = true,
        Callback = function(v)
            ESP_Settings.RoomExit = v
            for _, hl in ipairs(Workspace:GetDescendants()) do
                if hl.Name == "ExitESP" then hl.Enabled = v end
            end
        end
    })

    sESP:AddToggle({
        Name = "ESP Itens (GweenSodaPack)",
        Default = true,
        Callback = function(v)
            ESP_Settings.Soda = v
            for _, hl in ipairs(Workspace:GetDescendants()) do
                if hl.Name == "SodaESP" then hl.Enabled = v end
            end
        end
    })

    sESP:AddToggle({
        Name = "ESP Entidades + Alerta",
        Default = true,
        Callback = function(v)
            ESP_Settings.Entities = v
            for _, hl in ipairs(Workspace:GetDescendants()) do
                if hl.Name == "EntityESP" then hl.Enabled = v end
            end
        end
    })

    -- ==========================================
    -- 3. MOTOR DE ESP OTIMIZADO (Sem Lag)
    -- ==========================================
    local function createHighlight(parent, name, fillColor, outlineColor)
        if not parent or parent:FindFirstChild(name) then return end
        
        local hl = Instance.new("Highlight")
        hl.Name = name
        hl.FillColor = fillColor
        hl.OutlineColor = outlineColor
        hl.FillTransparency = 0.5
        hl.OutlineTransparency = 0
        hl.Adornee = parent
        hl.Parent = parent
        
        if name == "ExitESP" then hl.Enabled = ESP_Settings.RoomExit
        elseif name == "SodaESP" then hl.Enabled = ESP_Settings.Soda
        elseif name == "EntityESP" then hl.Enabled = ESP_Settings.Entities
        end
    end

    -- Sistema que analisa apenas quartos novos (Muito mais leve que GetDescendants constante)
    local function scanRoom(room)
        -- Procurar Saída
        local exit = room:FindFirstChild("RoomExit")
        if exit then
            local target = exit:IsA("Attachment") and exit.Parent or exit
            createHighlight(target, "ExitESP", Color3.fromRGB(0, 255, 255), Color3.fromRGB(255, 255, 255))
        end
        
        -- Procurar Itens (Soda) dentro do quarto
        for _, item in ipairs(room:GetDescendants()) do
            if item.Name == "GweenSodaPack" then
                createHighlight(item, "SodaESP", Color3.fromRGB(0, 255, 0), Color3.fromRGB(255, 255, 255))
            end
        end
    end

    -- Conectar às salas geradas
    task.spawn(function()
        local currentRooms = Workspace:WaitForChild("CurrentRooms", 10)
        if currentRooms then
            -- Verifica os quartos que já existem
            for _, room in ipairs(currentRooms:GetChildren()) do
                scanRoom(room)
            end
            -- Fica à escuta de novos quartos que o jogador abre
            currentRooms.ChildAdded:Connect(function(room)
                task.wait(0.5) -- Pequeno delay para os assets do quarto carregarem
                scanRoom(room)
            end)
        end
    end)

    -- Conectar às Entidades (Rush, Ambush, etc)
    task.spawn(function()
        local function handleEntity(entity)
            if ESP_Settings.Entities then
                Library:Notify({
                    Title = "⚠️ AVISO DE ENTIDADE",
                    Message = entity.Name .. " acabou de spawnar!",
                    Type = "error",
                    Duration = 5
                })
            end
            createHighlight(entity, "EntityESP", Color3.fromRGB(255, 0, 0), Color3.fromRGB(255, 255, 0))
        end

        local liveFolder = Workspace:WaitForChild("LiveEntities", 10)
        if liveFolder then
            for _, ent in ipairs(liveFolder:GetChildren()) do 
                handleEntity(ent) 
            end
            
            -- O ERRO CRÍTICO ANTERIOR ESTAVA AQUI, AGORA ESTÁ CORRIGIDO
            liveFolder.ChildAdded:Connect(function(ent)
                task.wait(0.1)
                handleEntity(ent)
            end)
        end
    end)

    Library:Notify({
        Title = "DOORS (PRO)",
        Message = "Módulo carregado e otimizado com sucesso!",
        Type = "success",
        Duration = 4
    })
end

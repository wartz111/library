-- Módulo DOORS - Premium Hub v10.9
return function(ctx)
    local L = ctx.L
    local Library = ctx.Library
    local Window = ctx.Window
    local Players = ctx.Players
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local LP = Players.LocalPlayer

    --================================================--
    -- 1. ABA DO DOORS (Usa a já existente ou cria se faltar)
    --================================================--
    local doorsTab = ctx.DoorsTab or Window:AddTab("Doors", "🚪")
    
    local sDoorsInfo = doorsTab:AddSection("Informações & Estado")
    local sDoorsESP = doorsTab:AddSection("Funcionalidades ESP & Alertas")
    
    local currentMode = "Desconhecido"
    pcall(function()
        local gameData = ReplicatedStorage:WaitForChild("GameData", 5)
        if gameData then
            local floor = gameData:FindFirstChild("Floor")
            if floor and floor:IsA("StringValue") then
                currentMode = floor.Value
            end
        end
    end)

    sDoorsInfo:AddButton({ Name = "Modo Atual: " .. tostring(currentMode), Callback = function()
        Library:Notify({Title = "DOORS", Message = "Modo de jogo atual: " .. tostring(currentMode), Type = "info"})
    end })

    -- Variáveis de controlo para os Toggles
    local espExitEnabled = true
    local espSodaEnabled = true
    local espEntityEnabled = true

    sDoorsESP:AddToggle({ Name = "ESP Saídas (RoomExit)", Default = true, Callback = function(v) 
        espExitEnabled = v 
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "RoomExitHighlight" then obj.Enabled = v end
        end
    end })

    sDoorsESP:AddToggle({ Name = "ESP GweenSodaPack", Default = true, Callback = function(v) 
        espSodaEnabled = v 
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "ItemHighlight" then obj.Enabled = v end
        end
    end })

    sDoorsESP:AddToggle({ Name = "Alerta e ESP de Entidades", Default = true, Callback = function(v) 
        espEntityEnabled = v 
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "EntityHighlight" then obj.Enabled = v end
        end
    end })

    Library:Notify({
        Title = "DOORS Carregado!",
        Message = "Funcionalidades aplicadas! Modo: " .. tostring(currentMode),
        Type = "success",
        Duration = 6
    })

    --================================================--
    -- 2. ESP PARA ROOMEXIT E GWEENSODAPACK (CurrentRooms)
    --================================================--
    local currentRooms = workspace:WaitForChild("CurrentRooms", 10)
    
    local function checkRoomDescendant(descendant)
        -- ESP para GweenSodaPack (Verde)
        if descendant.Name == "GweenSodaPack" then
            if not descendant:FindFirstChild("ItemHighlight") then
                local hl = Instance.new("Highlight")
                hl.Name = "ItemHighlight"
                hl.FillColor = Color3.fromRGB(0, 255, 0)
                hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                hl.FillTransparency = 0.4
                hl.OutlineTransparency = 0
                hl.Adornee = descendant
                hl.Enabled = espSodaEnabled
                hl.Parent = descendant
            end
        end

        -- ESP para portas RoomExit (Ciano)
        if descendant.Name == "RoomExit" then
            local targetPart = descendant
            if descendant:IsA("Attachment") then
                targetPart = descendant.Parent
            end
            
            if targetPart and (targetPart:IsA("BasePart") or targetPart:IsA("Model")) then
                if not targetPart:FindFirstChild("RoomExitHighlight") then
                    local hl = Instance.new("Highlight")
                    hl.Name = "RoomExitHighlight"
                    hl.FillColor = Color3.fromRGB(0, 255, 255)
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.FillTransparency = 0.5
                    hl.OutlineTransparency = 0
                    hl.Adornee = targetPart
                    hl.Enabled = espExitEnabled
                    hl.Parent = targetPart
                end
            end
        end
    end

    if currentRooms then
        for _, desc in ipairs(currentRooms:GetDescendants()) do
            task.spawn(function()
                checkRoomDescendant(desc)
            end)
        end

        currentRooms.DescendantAdded:Connect(function(desc)
            task.wait(0.1)
            checkRoomDescendant(desc)
        end)
    end

    --================================================--
    -- 3. ALERTA E ESP DE ENTIDADES (LiveEntities)
    --================================================--
    local function handleEntity(entity)
        if not entity or not entity.Parent then return end

        if espEntityEnabled then
            Library:Notify({
                Title = "⚠️ ENTIDADE DETETADA!",
                Message = entity.Name .. " surgiu no mapa!",
                Type = "error",
                Duration = 6
            })
        end

        if not entity:FindFirstChild("EntityHighlight") then
            local hl = Instance.new("Highlight")
            hl.Name = "EntityHighlight"
            hl.FillColor = Color3.fromRGB(255, 0, 0)
            hl.OutlineColor = Color3.fromRGB(255, 255, 0)
            hl.FillTransparency = 0.3
            hl.OutlineTransparency = 0
            hl.Adornee = entity
            hl.Enabled = espEntityEnabled
            hl.Parent = entity
        end
    end

    local function setupLiveEntities()
        local liveEntitiesFolder = workspace:WaitForChild("LiveEntities", 10) or workspace:FindFirstChild("LiveEntities")
        
        if liveEntitiesFolder then
            for _, entity in ipairs(liveEntitiesFolder:GetChildren()) do
                task.spawn(function()
                    handleEntity(entity)
                end)
            end

            liveEntitiesFolder.ChildAdded:Connect(function(entity)
                task.wait(0.1)
                handleEntity(entity)
            end)
        else
            workspace.ChildAdded:Connect(function(child)
                if child.Name == "LiveEntities" then
                    child.ChildAdded:Connect(function(entity)
                        task.wait(0.1)
                        handleEntity(entity)
                    end)
                end
            end)
        end
    end

    task.spawn(setupLiveEntities)
end
